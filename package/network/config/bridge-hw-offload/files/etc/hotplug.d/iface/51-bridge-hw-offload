#!/bin/sh

case "$ACTION" in ifup|ifupdate|ifdown) ;; *) exit 0;; esac
[ "$INTERFACE" = lan ] || exit 0
[ -x /etc/rc.d/S21bridge-hw-offload ] || exit 0

# Wait for bridge membership updates, then read the latest configuration.
# Serialization and error reporting are handled by apply-rules.sh.
(
	sleep 2
	/etc/init.d/bridge-hw-offload reload
) &
