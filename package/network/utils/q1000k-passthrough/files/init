#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/q1000k-passthrough-watch-config
	procd_set_param term_timeout 30
	# Avoid libsetlbf injection into a shell that writes procfs sysctls.
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# WAN events wake the existing owner; they must not force a network restart.
	procd_send_signal xgspon-passthrough '*' USR1
}

# Committed xgspon.passthrough changes are observed by the wrapper, including
# plain uci commit. A config.change trigger would apply the same edit twice.
