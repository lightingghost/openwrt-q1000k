      "hypothesis": "H1-H8",
      "implemented": true,
      "hardware_run": false
    },
    {
      "id": "B02",
      "test": "Three fresh RX starts",
      "selection": "rx-startup,rx-repeat-1,rx-repeat-2",
      "hypothesis": "H5-H6",
      "implemented": true,
      "hardware_run": false
    },
    {
      "id": "B03",
