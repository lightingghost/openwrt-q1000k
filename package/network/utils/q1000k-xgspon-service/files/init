#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=95
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="stop_monitor"
EXTRA_HELP="        stop_monitor    Release automatic diagnostics for a bench session"

start_service() {
	local state=/var/run/xgspon-config source snapshot enabled monitor
	. /lib/q1000k-xgspon/apply.sh
	source=${Q1000K_CONFIG_APPLY_SNAPSHOT:-/etc/config/xgspon}
	snapshot=$state/optical-applied
	umask 077
	mkdir -p "$state" || return 1
	cp "$source" "$state/optical-pending" || return 1
	Q1000K_UCI_SNAPSHOT="$state/optical-pending"
	export Q1000K_UCI_SNAPSHOT
	xgspon_validate_optical || {
		rm -f "$state/optical-pending"
		echo 'XGS-PON: invalid committed optical settings; service not started.' >&2
		return 1
	}
	xgspon_optical_key > "$state/optical.key.next" || return 1
	mv "$state/optical-pending" "$snapshot" || return 1
	enabled=$xgspon_enabled
	monitor=$xgspon_monitor
	[ "$enabled:$monitor" != 0:0 ] || {
		mv "$state/optical.key.next" "$state/optical.key"
		return
	}
	Q1000K_UCI_SNAPSHOT=$snapshot
	procd_open_instance
	if [ "$enabled" = 1 ]; then
		procd_set_param command /usr/libexec/q1000k-xgspon-run
	else
		procd_set_param command /usr/libexec/q1000k-xgspon-run --monitor
	fi
	procd_set_param env "Q1000K_UCI_SNAPSHOT=$snapshot"
	# stdout logging injects libsetlbf into ash and splits builtin printf writes
	# to sysfs command attributes. Reports use status.json; keep stderr logging.
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param term_timeout 150
	# Hardware faults require an explicit restart after diagnosis.
	procd_close_instance
	mv "$state/optical.key.next" "$state/optical.key"
}

stop_service() {
	rm -f /var/run/xgspon-config/optical.key
}

stop_monitor() {
	local count=0
	[ -f /var/run/q1000k-xgspon/monitor ] || return 0
	stop
	while [ -d /var/run/q1000k-xgspon/lock ] && [ "$count" -lt 15 ]; do
		sleep 1
		count=$((count + 1))
	done
	[ ! -d /var/run/q1000k-xgspon/lock ]
}

reload_service() {
	local count=0
	stop || return 1
	# procd's delete request is asynchronous. Wait for the optical cleanup
	# lock before replacing its committed snapshot or starting a new owner.
	while [ -d /var/run/q1000k-xgspon/lock ]; do
		[ "$count" -lt 150 ] || return 1
		sleep 1
		count=$((count + 1))
	done
	if [ -f /var/run/q1000k-xgspon/status.json ] &&
		grep -Fq '"stage":"cleanup_failed"' /var/run/q1000k-xgspon/status.json; then
		return 1
	fi
	# An apply must observe a fresh status from the new procd owner, not a
	# running status left behind by a process that exited unexpectedly.
	rm -f /var/run/q1000k-xgspon/status.json
	start
}

service_triggers() {
	procd_add_config_trigger config.change xgspon /usr/sbin/reload_xgspon_config
}
