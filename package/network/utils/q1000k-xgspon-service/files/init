#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load q1000k-xgspon
	config_get_bool enabled service enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/q1000k-xgspon-run
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 120
	# Hardware faults require an explicit restart after diagnosis.
	procd_close_instance
}

reload_service() {
	stop
	start
}

# Configuration edits take effect only after an explicit start/restart/reload.
# In particular, saving identity overrides in LuCI does not activate hardware.
