#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Installed only by the explicit private activation image builder, after the
# ordinary RAM bench and inactive WAN defaults. No credentials in this script.
set -eu
[ -f /etc/q1000k-private-autostart ] || exit 0
[ -f /sys/firmware/devicetree/base/quantum,xgspon-activation-bench ] || exit 1
[ "$(uci -q get q1000k-xgspon.service.continuous_bench)" = 1 ] || exit 1
for interface in wan wan6; do
	[ "$(uci -q get network.$interface.q1000k_profile)" = 1 ] || exit 1
done
# netifd starts at S20, before the optical owner at S95. The owner starts the
# inactive WAN clients once O5/authentication/OMCI provisioning are stable.
# LAN DHCP remains available even with the fiber disconnected.
uci -q batch <<'UCI'
set network.wan.auto='0'
set network.wan.ipv6='1'
set network.wan6.auto='0'
set network.wan6.reqaddress='none'
set network.wan6.reqprefix='auto'
set network.wan6.ip6assign='64'
set network.wan6.ip6hint='f'
set network.wan6.ip6ifaceid='::1'
delete network.wan6.ip6class
add_list network.wan6.ip6class='wan6'
set network.lan.ip6assign='64'
set network.lan.ip6hint='0'
set network.lan.ip6ifaceid='::1'
delete network.lan.ip6class
add_list network.lan.ip6class='wan6'
set dhcp.lan.ignore='0'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
set dhcp.lan.ra='server'
set dhcp.lan.dhcpv6='server'
set dhcp.lan.ndp='disabled'
set dhcp.lan.ra_slaac='1'
delete dhcp.lan.ra_flags
add_list dhcp.lan.ra_flags='managed-config'
add_list dhcp.lan.ra_flags='other-config'
set q1000k-xgspon.service.enabled='1'
set q1000k-xgspon.service.lower='ponraw'
commit network
commit dhcp
commit q1000k-xgspon
UCI
