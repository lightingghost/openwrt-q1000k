config identity 'identity'
	# Normal images always use UBI factory serial/MAC/calibration. These
	# overrides are available only to the separate private RAM bench profile.
	option serial ''
	option wan_mac ''
	# Required by the optional service: 1..36 bytes of hex, zero-padded on the right.
	option registration_id ''
	# Optional printable OMCI fields; empty values keep native defaults.
	option equipment_id ''
	# Legacy combined version, superseded by the separate fields below.
	option omci_version ''
	option vendor_id ''
	option hardware_version ''
	option software_version_a ''
	option software_version_b ''
	option logical_onu_id ''
	option logical_password ''
	option active_bank ''
	option committed_bank ''
	option sync_circuit_pack '1'
	option mib_profile 'native-pptp'
	option fix_vlans '0'
	# Advertised identity, applied before the first OMCI MIB is constructed.
	option omcc_version ''
	option pon_slot ''
	option olt_profile 'auto'
	# Optional ME 134 identity; empty fields leave the IP-host object absent.
	option iphost_mac ''
	option iphost_hostname ''
	option iphost_domain ''

config service 'service'
	# Load and initialize optical diagnostics with TX disabled at boot.
	option monitor '1'
	option enabled '0'
	# The normal board supervisor owns this native DMA endpoint.
	option lower 'ponraw'
	# Private activation RAM images opt in; ignored without their image marker/DT.
	option continuous_bench '0'

config passthrough 'passthrough'
	# IPv4 WAN-event integration. IPv6 delegation uses network/dhcp settings.
	option mode 'router'
	option client_mac ''
