config identity 'identity'
	# Empty overrides use the preserved Q1000K factory identity.
	option serial ''
	option wan_mac ''
	# Required by the optional service: the OLT's 36-byte ID, encoded as hex.
	option registration_id ''
	# Optional printable OMCI fields; empty values keep native defaults.
	option equipment_id ''
	option omci_version ''

config service 'service'
	option enabled '0'
	# Explicit native PON lower interface; it must already be up.
	option lower ''
