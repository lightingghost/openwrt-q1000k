#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
. /lib/q1000k-xgspon/common.sh

case "$1" in
	status) xgspon_status ;;
	validate) xgspon_validate ;;
	detect|off)
		controller=$(find_controller) || {
			echo 'Q1000K controller driver is unavailable; load q1000k-pon-control on a matching board DT.' >&2
			exit 1
		}
		printf '%s\n' "$1" > "$controller/operation"
		result=$?
		xgspon_status
		exit "$result"
		;;
	prepare|initialize)
		# Stage this unit's exact calibration record in private RAM storage.
		# prepare only stages data. initialize additionally powers XGS-PON
		# and loads/verifies MD32 with TX disabled. Neither loads modules.
		umask 077
		read_identity
		read_firmware
		read_calibration
		[ "$calibration_available" = 1 ] &&
		[ "$pm_ready" = 1 ] && [ "$dm_ready" = 1 ] || {
			echo 'Unit calibration and verified OEM firmware are required.' >&2
			exit 1
		}
		dir=$(mktemp -d /tmp/q1000k-xgspon.XXXXXX) || exit 1
		if ! calibration_read > "$dir/xgspon-calibration.bin"; then
			rm -f "$dir/xgspon-calibration.bin"
			rmdir "$dir"
			exit 1
		fi
		if [ "$1" = initialize ]; then
			trap 'rm -f "$dir/xgspon-calibration.bin"; rmdir "$dir"' EXIT HUP INT TERM
			controller=$(find_controller) || {
				echo 'Q1000K controller driver is unavailable.' >&2
				exit 1
			}
			cat "$dir/xgspon-calibration.bin" > "$controller/calibration" || exit 1
			printf 'initialize\n' > "$controller/operation"
			result=$?
			xgspon_status
			exit "$result"
		fi
		printf '%s\n' "$dir"
		;;
	start|stop|restart|reload)
		[ -x /etc/init.d/q1000k-xgspon ] || {
			echo 'The optional q1000k-xgspon-service package is unavailable.' >&2
			exit 1
		}
		exec /etc/init.d/q1000k-xgspon "$1"
		;;
	*) echo 'Usage: q1000k-xgspon status|validate|prepare|detect|initialize|off|start|stop|restart|reload' >&2; exit 2 ;;
esac
