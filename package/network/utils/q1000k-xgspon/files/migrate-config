#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Keep legacy identity/service values, including automatic private RAM startup.
# Only a missing or still factory-default canonical file can be replaced.
set -eu
umask 077
config=/etc/config/xgspon
defaults=/usr/share/xgspon/defaults
marker=/etc/xgspon-config-migrated
[ ! -e "$marker" ] || exit 0
source=$config
if [ ! -e "$config" ] || cmp -s "$config" "$defaults"; then
	source=$defaults
	for candidate in /etc/xgspon-legacy-config /etc/config/q1000k-xgspon /etc/config/q1000k-xgspon.apk-save; do
		if [ -f "$candidate" ]; then source=$candidate; break; fi
	done
fi
work=$(mktemp -d /tmp/xgspon-migrate-XXXXXX)
trap 'rm -rf "$work"' EXIT
mkdir "$work/delta" "$work/overrides"
# A unique private package cannot load the normal staged UCI changes.
name="migration-${work##*/}"
cp "$source" "$work/$name"
read_config() { uci -q -c "$work" -C "$work/overrides" -t "$work/delta" "$@"; }
read_config export "$name" >/dev/null || exit 1
# Fresh normal UBI/recovery installations opt into registration. The public
# diagnostic RAM bench remains TX-disabled, and restored/legacy configurations
# (including an explicit disabled choice) retain their settings.
if [ "$source" = "$defaults" ] &&
   [ -f /sys/firmware/devicetree/base/quantum,xgspon-service ] &&
   [ ! -f /sys/firmware/devicetree/base/quantum,xgspon-bench ]; then
	read_config set "$name.service.enabled=1"
	read_config commit "$name"
fi
# Older identity files have no passthrough section. Add only the disabled
# default, so LuCI can render its NamedSection without changing other values.
if ! read_config get "$name.passthrough" >/dev/null; then
	cat >> "$work/$name" <<'EOF'

config passthrough 'passthrough'
	option mode 'router'
	option client_mac ''
EOF
fi
if ! cmp -s "$work/$name" "$config"; then
	cp "$work/$name" "$config.new"
	chmod 600 "$config.new"
	mv "$config.new" "$config"
fi
printf 'xgspon-v1\n' > "$marker"
