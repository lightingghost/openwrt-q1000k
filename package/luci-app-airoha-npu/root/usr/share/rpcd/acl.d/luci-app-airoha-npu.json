{
	"luci-app-airoha-npu": {
		"description": "Airoha status, temperatures and offload settings",
		"read": {
			"ubus": {
				"luci.airoha_npu": [
					"getStatus",
					"getPpeEntries",
					"getTokenInfo",
					"getFrameEngine",
					"getVlanOffload",
					"getPPPoEOffload",
					"getTemperatures"
				]
			},
			"file": {
				"/sys/kernel/debug/ppe/entries": [
					"read"
				],
				"/sys/kernel/debug/ppe/bind": [
					"read"
				],
				"/sys/devices/system/cpu/cpufreq/policy0/*": [
					"read"
				],
				"/sys/kernel/debug/ieee80211/*/mt76/token_info": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"luci.airoha_npu": [
					"setGovernor",
					"setMaxFreq",
					"setVlanOffload",
					"setPPPoEOffload"
				]
			}
		}
	}
}
