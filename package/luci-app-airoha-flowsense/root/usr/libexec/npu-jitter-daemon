#!/bin/sh
# Foreground procd service: rolling RTT, loss, mean absolute deviation and CPU.
export LC_ALL=C
CONFIGURED_TARGET="${1:-}"
case "$CONFIGURED_TARGET" in -*|*[!a-zA-Z0-9.:_%-]*) exit 1 ;; esac
[ "${#CONFIGURED_TARGET}" -le 253 ] || exit 1
RESULT_FILE="/tmp/npu-jitter.json"
WINDOW=10
INTERVAL=2
values=""
previous_target=""
cpu_prev=""

gateway() {
	ip -4 route show default 2>/dev/null | awk '
		{ for (i=1;i<NF;i++) if ($i=="via") { print $(i+1); exit } }'
}
gateway6() {
	ip -6 route show default 2>/dev/null | awk '
		{ via=""; dev=""; for(i=1;i<NF;i++) {
			if ($i=="via") via=$(i+1); if ($i=="dev") dev=$(i+1)
		} if (via!="") { print via (via ~ /^fe80:/ && dev!="" ? "%" dev : ""); exit } }'
}

while true; do
	TARGET="$CONFIGURED_TARGET"
	[ -n "$TARGET" ] || TARGET=$(gateway)
	[ -n "$TARGET" ] || TARGET=$(gateway6)
	case "$TARGET" in -*|*[!a-zA-Z0-9.:_%-]*) TARGET="" ;; esac
	if [ "$TARGET" != "$previous_target" ]; then
		values=""
		previous_target="$TARGET"
	fi

	cpu_now=$(awk '/^cpu /{print $2,$3,$4,$5,$6,$7,$8,$9; exit}' /proc/stat 2>/dev/null)
	cpu_pct=0
	if [ -n "$cpu_prev" ] && [ -n "$cpu_now" ]; then
		cpu_pct=$(awk -v a="$cpu_prev" -v b="$cpu_now" 'BEGIN {
			split(a,p," "); split(b,c," "); pt=0; ct=0
			for(i=1;i<=8;i++) { pt+=p[i]; ct+=c[i] }
			dt=ct-pt; di=(c[4]+c[5])-(p[4]+p[5])
			print (dt>0 ? int(100*(dt-di)/dt) : 0)
		}')
	fi
	cpu_prev="$cpu_now"

	rtt=""
	if [ -n "$TARGET" ]; then
		family=-4
		case "$TARGET" in *:*) family=-6 ;; esac
		# iputils supplies both address families and a bounded ICMP deadline.
		# Parse a reply, not a summary field whose position varies by ping build.
		rtt=$(/usr/bin/ping "$family" -n -c 1 -W 1 -w 2 "$TARGET" 2>/dev/null | awk '
			/time[=<][0-9]/ {
				sub(/.*time[=<]/, ""); sub(/[^0-9.].*/, "")
				if ($0 ~ /^[0-9]+([.][0-9]+)?$/) { print $0; exit }
			}')
		values="$values ${rtt:-x}"
	fi
	updated=$(cut -d. -f1 /proc/uptime)
	# Trim attempts (including losses), then derive stats only from replies.
	values=$(printf '%s\n' "$values" | awk -v w="$WINDOW" '{
		start=NF-w+1; if(start<1) start=1
		for(i=start;i<=NF;i++) printf "%s%s", (i>start ? " " : ""), $i
	}')
	printf '%s\n' "$values" | awk -v target="$TARGET" -v cpu="$cpu_pct" -v updated="$updated" '{
		n=0; sum=0; dev=0
		for(i=1;i<=NF;i++) if($i!="x") { n++; sum+=$i }
		avg=n ? sum/n : 0
		for(i=1;i<=NF;i++) if($i!="x") dev+=($i>avg ? $i-avg : avg-$i)
		reply=NF && $NF!="x"; state=target=="" ? "no_target" : reply ? "ok" : "unreachable"
		printf "{\"state\":\"%s\",\"target\":\"%s\",\"available\":%s,\"reachable\":%s,\"last_ping\":%s,\"jitter\":%.3f,\"samples\":%d,\"attempts\":%d,\"loss\":%.1f,\"cpu_pct\":%d,\"updated\":%d}\n",
			state,target,target!="" ? "true" : "false",reply ? "true" : "false",
			reply ? $NF : "null", n ? dev/n : 0,n,NF,NF ? 100*(NF-n)/NF : 0,cpu,updated
	}' > "$RESULT_FILE.tmp" && mv "$RESULT_FILE.tmp" "$RESULT_FILE"
	sleep "$INTERVAL"
done
