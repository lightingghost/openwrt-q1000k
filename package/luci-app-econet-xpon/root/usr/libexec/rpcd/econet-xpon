#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Q1000K backend for the imported econet-xpon LuCI application.
case "$1" in
    list) echo '{"status":{},"raw":{},"mib":{}}' ;;
    call)
        case "$2" in
            status|raw) exec /usr/sbin/q1000k-xgspon status ;;
            mib)
                if data=$(/usr/sbin/q1000k-omci -i pon mib 2>/dev/null); then
                    printf '{"schema_version":1,"available":true,"entities":%s}\n' "$data"
                else
                    echo '{"schema_version":1,"available":false,"entities":null}'
                fi
                ;;
            *) exit 1 ;;
        esac
        ;;
    *) exit 1 ;;
esac
