+/* Physical service record bridge. The command guard spans the whole
+ * transaction; this spinlock only protects software copies/publication.
+ */
+int q1000k_gwan_table_begin(void)
+{
+	unsigned long flags;
+	int ret;
+
+	if (READ_ONCE(q1000k_gwan_error))
+		return READ_ONCE(q1000k_gwan_error);
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	ret = q1000k_gwan_error;
+	if (!ret)
+		q1000k_gwan_changing = true;
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	if (ret)
+		atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
+
+void q1000k_gwan_table_end(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	q1000k_gwan_changing = false;
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+}
+
+int q1000k_gwan_snapshot(struct q1000k_gwan_table *table)
+{
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	if (!table)
+		return -EINVAL;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	ret = q1000k_gwan_error;
+	if (ret)
+		goto out;
+	memset(table, 0, sizeof(*table));
+	for (i = 0; i < Q1000K_GWAN_CHANNELS; i++)
+		table->alloc_id[i] = gpWanPriv->gpon.allocId[i];
+	for (i = 0; i < Q1000K_GWAN_GEMS; i++) {
+		const GWAN_GemInfo_T *info = &gpWanPriv->gpon.gemPort[i].info;
+		struct q1000k_gwan_entry *e = &table->gem[i];
+
+		if (!info->valid)
+			continue;
+		e->valid = true;
+		e->gem = info->portId;
+		e->alloc_id = info->allocId;
+		e->ani = info->ani;
+		e->channel = info->channel;
+		e->multicast = info->channel == GPON_MULTICAST_CHANNEL;
+		e->encrypted = info->rxEncrypt || info->txEncrypt;
+	}
+out:
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	return ret;
+}
+
+void q1000k_gwan_table_publish(const struct q1000k_gwan_table *table)
+{
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	/* Clear old lookup slots before installing any reused GEM identifiers. */
+	for (i = 0; i < Q1000K_GWAN_GEMS; i++)
+		if (gpWanPriv->gpon.gemPort[i].info.valid && gpWanPriv->gpon.gemPort[i].info.channel)
+			gpWanPriv->gpon.gemIdToIndex[gpWanPriv->gpon.gemPort[i].info.portId] = GPON_GEM_IDX_MASK;
+	gpWanPriv->activeChannelNum = 0;
+	for (i = 0; i < Q1000K_GWAN_CHANNELS; i++) {
+		gpWanPriv->gpon.allocId[i] = table->alloc_id[i];
+		if (table->alloc_id[i] != Q1000K_GWAN_UNASSIGNED)
+			gpWanPriv->activeChannelNum++;
+	}
+	gpWanPriv->gpon.gemNumbers = 0;
+	for (i = 0; i < Q1000K_GWAN_GEMS; i++) {
+		const struct q1000k_gwan_entry *e = &table->gem[i];
+		GWAN_GemInfo_T *info = &gpWanPriv->gpon.gemPort[i].info;
+
+		if (e->valid && !e->channel) {
+			gpWanPriv->gpon.gemNumbers++;
+			continue;
+		}
+		if (!e->valid || !info->valid || e->gem != info->portId)
+			memset(&gpWanPriv->gpon.gemPort[i].stats, 0, sizeof(gpWanPriv->gpon.gemPort[i].stats));
+		memset(info, 0, sizeof(*info));
+		if (!e->valid)
+			continue;
+		info->valid = true;
+		info->portId = e->gem;
+		info->allocId = e->alloc_id;
+		info->ani = e->ani;
+		info->channel = e->channel;
+		info->rxEncrypt = info->txEncrypt = e->encrypted;
+		gpWanPriv->gpon.gemIdToIndex[e->gem] = i;
+		gpWanPriv->gpon.gemNumbers++;
+	}
+	q1000k_gwan_retiring_channels = 0;
+	memset(q1000k_gwan_retiring_gems, 0, sizeof(q1000k_gwan_retiring_gems));
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+}
+
+void q1000k_gwan_table_failed(int error)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	if (!q1000k_gwan_error)
+		q1000k_gwan_error = error < 0 ? error : -EIO;
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+}
