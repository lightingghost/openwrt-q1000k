 {
+#ifdef Q1000K_PON_IDENTITY
+	return q1000k_gwan_remove_tcont(allocId);
+#else
 	int i=0 ;
 	QDMA_ChannelStatus_T chnlCloseStatusSet = {0};
 	uint readData = 0;
@@ -353,11 +487,15 @@
 	}
 
 	return -ENOENT ;
+#endif
 }
 /*****************************************************************************
 ******************************************************************************/
 int gwan_remove_all_tcont(void)
 {
+#ifdef Q1000K_PON_IDENTITY
+	return q1000k_gwan_remove_all_tcont();
+#else
 	int i = 0;
 
 	for(i=0 ; i< CONFIG_GPON_10G_MAX_TCONT ; i++) {
@@ -366,6 +504,7 @@
 	}
 	
 	return 0 ;
+#endif
 }
 
