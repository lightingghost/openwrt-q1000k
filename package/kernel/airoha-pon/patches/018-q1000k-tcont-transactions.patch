+#endif
 	PON_MSG(MSG_INT, "gpon_disable: mac %s reset.\n",(type==GPON_MAC_PLAIN_RESET ? "plain":"with phy")) ;
 		
 	snSendInO23Cnt=0;
@@ -323,7 +331,9 @@
