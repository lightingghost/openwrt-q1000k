 /*****************************************************************************
 ******************************************************************************/
+#ifdef Q1000K_PON_IDENTITY
+static atomic_t q1000k_tcont_config_busy = ATOMIC_INIT(0);
+
+static int q1000k_gwan_create_tcont(u16 alloc_id)
+{
+	int channel, ret, cleanup, i;
+
+	if (alloc_id > Q1000K_ALLOC_ID_MAX)
+		return -EINVAL;
+	if (GPON_ONU_ID < GPON_UNASSIGN_ONU_ID && alloc_id == GPON_ONU_ID)
+		return -EOPNOTSUPP;
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	for (i = 0; i < CONFIG_GPON_10G_MAX_TCONT; i++) {
+		if (gpWanPriv->gpon.allocId[i] == alloc_id) {
+			ret = -EEXIST;
+			goto out;
+		}
+	}
+	channel = gponDevEnableTCont(alloc_id);
+	if (channel < 0) {
+		ret = channel;
+		goto out;
+	}
+	if (!channel || channel >= CONFIG_GPON_10G_MAX_TCONT) {
+		ret = -EIO;
+		goto out;
+	}
+	/* Native attachment starts closed; verify closure before enabling FE. */
+	ret = q1000k_transport_set_queue_close(channel, 0xff);
+	if (ret)
+		goto rollback;
+	ret = FE_API_SET_CHANNEL_ENABLE(FE_GDM_SEL_GDMA2, FE_GDM_SEL_TX,
+				channel, FE_ENABLE);
+	if (ret)
+		goto rollback;
+	ret = q1000k_transport_set_queue_close(channel, 0);
+	if (ret)
+		goto rollback;
+	/* Publish the allocation last. Existing GEM entries for this Alloc-ID
+	 * remain unusable while the software allocation is unassigned.
+	 */
+	for (i = 0; i < CONFIG_GPON_10G_MAX_GEMPORT; i++) {
+		if (gpWanPriv->gpon.gemPort[i].info.valid &&
+		    gpWanPriv->gpon.gemPort[i].info.allocId == alloc_id) {
+			gpon_recovery_set_channel(gpWanPriv->gpon.gemPort[i].info.portId,
+					  channel);
+			gpWanPriv->gpon.gemPort[i].info.channel = channel;
+		}
+	}
+	WRITE_ONCE(gpWanPriv->gpon.allocId[channel], alloc_id);
+	gpWanPriv->activeChannelNum++;
+	ret = 0;
+	goto out;
+rollback:
+	/* Even successful rollback does not prove FE/optical FIFO retirement.
+	 * Never reuse this slot during the current MAC instance.
+	 */
+	q1000k_tcont_quarantine(channel);
+	cleanup = q1000k_transport_set_queue_close(channel, 0xff);
+	if (cleanup)
+		pr_err("Q1000K T-CONT %d queue rollback failed: %d\n", channel, cleanup);
+	cleanup = FE_API_SET_CHANNEL_ENABLE(FE_GDM_SEL_GDMA2, FE_GDM_SEL_TX,
+				channel, FE_DISABLE);
+	if (cleanup)
+		pr_err("Q1000K T-CONT %d FE rollback failed: %d\n", channel, cleanup);
+	cleanup = gponDevDisableTCont(alloc_id);
+	if (cleanup != channel)
+		pr_err("Q1000K T-CONT %d MAC rollback failed: %d\n", channel, cleanup);
+	if (ret > 0)
+		ret = -EIO;
+out:
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
+
+static int q1000k_gwan_remove_tcont(u16 alloc_id)
+{
+	int i, ret = -ENOENT;
+
+	if (alloc_id > Q1000K_ALLOC_ID_MAX)
+		return -EINVAL;
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	for (i = 0; i < CONFIG_GPON_10G_MAX_TCONT; i++) {
+		if (gpWanPriv->gpon.allocId[i] != alloc_id)
+			continue;
+		q1000k_tcont_quarantine(i);
+		ret = q1000k_transport_set_queue_close(i, 0xff);
+		/* G_TX_FCS_TBL_INIT is global. Do not reset it for one T-CONT or
+		 * claim removal until native descriptors and FE/optical FIFOs have
+		 * a verified retirement path. Keep bindings/counts for diagnosis.
+		 */
+		if (!ret)
+			ret = -EOPNOTSUPP;
+		break;
+	}
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
+
+static int q1000k_gwan_remove_all_tcont(void)
+{
+	int i, err, ret = 0;
+
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	for (i = 0; i < CONFIG_GPON_10G_MAX_TCONT; i++) {
+		if (gpWanPriv->gpon.allocId[i] == GPON_10G_UNASSIGN_ALLOC_ID)
+			continue;
+		q1000k_tcont_quarantine(i);
+		err = q1000k_transport_set_queue_close(i, 0xff);
+		/* Try to close every assigned channel, preserving the first error. */
+		if (err && (!ret || ret == -EOPNOTSUPP))
+			ret = err;
+		else if (!ret)
+			ret = -EOPNOTSUPP;
+	}
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
+#endif
+
 int gwan_create_new_tcont(ushort allocId)
 {
+#ifdef Q1000K_PON_IDENTITY
+	return q1000k_gwan_create_tcont(allocId);
+#else
 	int ret = 0;
 	unchar channel = 0;
 	uint i=0;
@@ -303,12 +433,16 @@
 	} 
 	
 	return ret ;
+#endif
 }
 
