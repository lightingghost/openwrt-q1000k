 	gpGponPriv->gponSecurity.omciIkIdx = GPON_OMCI_IK_IDX1;	
     gpGponPriv->gponSecurity.kekIdx = GPON_KEK_IK_IDX1;
-	gwan_remove_all_tcont();	
