+		return -EINVAL;
+	return an7581_xpon_mac_stop(AN7581_XPON_MPI_TX_STOP,
+				    mode == XPON_RESET_HOLD_ON);
+#else
 	REG_MBI_MPI_STOP gponMbiMpiStop ;
     int RETRY = 3000 ;
 
@@ -288,10 +318,17 @@
     	}
     }
 	return 0 ;
+#endif
 }
 
 int gponDevMpiRxStop(XPON_RESET_MODE_t mode)
 {
+#ifdef Q1000K_PON_IDENTITY
+	if (mode != XPON_RESET_HOLD_ON && mode != XPON_RESET_RELEASE)
+		return -EINVAL;
+	return an7581_xpon_mac_stop(AN7581_XPON_MPI_RX_STOP,
+				    mode == XPON_RESET_HOLD_ON);
+#else
 	REG_MBI_MPI_STOP gponMbiMpiStop ;
     int RETRY = 3000 ;
 
@@ -314,11 +351,18 @@
     	}
     }
 	return 0 ;
+#endif
 }
 
 
 int gponDevMpiStop(XPON_RESET_MODE_t mode)
 {
+#ifdef Q1000K_PON_IDENTITY
+	if (mode != XPON_RESET_HOLD_ON && mode != XPON_RESET_RELEASE)
+		return -EINVAL;
+	return an7581_xpon_mac_stop(AN7581_XPON_MPI_TX_STOP | AN7581_XPON_MPI_RX_STOP,
+				    mode == XPON_RESET_HOLD_ON);
+#else
 	REG_MBI_MPI_STOP gponMbiMpiStop ;
     int RETRY = 3000 ;
 
@@ -342,6 +386,7 @@
     	}
     }
 	return 0 ;
+#endif
 }
 
 /*****************************************************************************
@@ -3400,6 +3445,9 @@
 }
 
 int gponDevWaitTxAlignFifoUnused(void){
+#ifdef Q1000K_PON_IDENTITY
+	return an7581_xpon_mac_wait_tx_empty();
+#else
 	REG_DBG_TX_ALIGN_FIFO_STS txAlignFifoUsed;
 	int RETRY = 3000 ;
 
@@ -3411,6 +3459,7 @@
 	}
 	
