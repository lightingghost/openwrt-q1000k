 /*****************************************************************************
--- a/xpon-en757x/xpon_10g/src/pwan/gpon_wan.c
+++ b/xpon-en757x/xpon_10g/src/pwan/gpon_wan.c
@@ -46,6 +46,8 @@
 #include "common/xpon_global.h"
 #ifdef Q1000K_PON_IDENTITY
 #include "common/q1000k_tcont.h"
+#include "common/q1000k_gem.h"
+#include "common/q1000k_gwan.h"
 #include "common/q1000k_transport.h"
 #endif
 #include <ecnt_hook/ecnt_hook_fe.h>
@@ -274,6 +276,367 @@
 #ifdef Q1000K_PON_IDENTITY
 static atomic_t q1000k_tcont_config_busy = ATOMIC_INIT(0);
 
+/* One nonblocking guard serializes GEM and T-CONT control transactions.
+ * The separate IRQ-safe lock protects only software publication/snapshots.
+ * Native/FE/MAC callbacks must never execute under this state lock.
+ */
+static DEFINE_SPINLOCK(q1000k_gwan_lock);
+static u32 q1000k_gwan_retiring_channels;
+static bool q1000k_gwan_retiring_gems[CONFIG_GPON_10G_MAX_GEMPORT];
+
+static int q1000k_gwan_index_locked(u16 gem)
+{
+	unsigned int index;
+
+	lockdep_assert_held(&q1000k_gwan_lock);
+	if (gem > Q1000K_GEM_ID_MAX)
+		return -EINVAL;
+	index = gpWanPriv->gpon.gemIdToIndex[gem] & GPON_GEM_IDX_MASK;
+	if (index >= CONFIG_GPON_10G_MAX_GEMPORT ||
+	    !gpWanPriv->gpon.gemPort[index].info.valid ||
+	    gpWanPriv->gpon.gemPort[index].info.portId != gem)
+		return -ENOENT;
+	return index;
+}
+
+int q1000k_gwan_binding(u16 gem, bool tx, struct q1000k_gwan_binding *binding)
+{
+	struct q1000k_gwan_binding result;
+	const GWAN_GemInfo_T *info;
+	unsigned long flags;
+	int index, ret = 0;
+
+	if (!binding)
+		return -EINVAL;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	index = q1000k_gwan_index_locked(gem);
+	if (index < 0) {
+		ret = index;
+		goto out;
+	}
+	info = &gpWanPriv->gpon.gemPort[index].info;
+	if (q1000k_gem_faulted()) {
+		ret = -EIO;
+		goto out;
+	}
+	if (q1000k_gwan_retiring_gems[index]) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	if (info->ani >= GPON_MAX_ANI_INTERFACE) {
+		ret = -ENODATA;
+		goto out;
+	}
+	if (info->channel == GPON_MULTICAST_CHANNEL) {
+		if (tx) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+	} else {
+		if (!info->channel || info->channel >= CONFIG_GPON_10G_MAX_TCONT ||
+		    info->allocId > Q1000K_ALLOC_ID_MAX ||
+		    gpWanPriv->gpon.allocId[info->channel] != info->allocId) {
+			ret = -ENODATA;
+			goto out;
+		}
+		if (q1000k_gwan_retiring_channels & BIT(info->channel)) {
+			ret = -ESHUTDOWN;
+			goto out;
+		}
+	}
+	result.gem = gem;
+	result.alloc_id = info->allocId;
+	result.ani = info->ani;
+	result.channel = info->channel;
+	result.index = index;
+	result.multicast = info->channel == GPON_MULTICAST_CHANNEL;
+	*binding = result;
+out:
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	return ret;
+}
+
+void q1000k_gwan_account(u16 gem, bool tx, unsigned int bytes)
+{
+	struct net_device_stats *stats;
+	unsigned long flags;
+	int index;
+
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	index = q1000k_gwan_index_locked(gem);
+	if (index >= 0) {
+		stats = &gpWanPriv->gpon.gemPort[index].stats;
+		if (tx) {
+			stats->tx_packets++;
+			stats->tx_bytes += bytes;
+		} else {
+			stats->rx_packets++;
+			stats->rx_bytes += bytes;
+		}
+	}
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+}
+
+static void q1000k_gwan_retire_channel(u8 channel)
+{
+	unsigned long flags;
+
+	if (channel >= CONFIG_GPON_10G_MAX_TCONT)
+		return;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	q1000k_gwan_retiring_channels |= BIT(channel);
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+}
+
+static void q1000k_gwan_publish_tcont(u8 channel, u16 alloc_id)
+{
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	for (i = 0; i < CONFIG_GPON_10G_MAX_GEMPORT; i++) {
+		GWAN_GemInfo_T *info = &gpWanPriv->gpon.gemPort[i].info;
+
+		if (info->valid && info->allocId == alloc_id &&
+		    info->channel == GPON_UNKNOWN_CHANNEL &&
+		    !q1000k_gwan_retiring_gems[i])
+			info->channel = channel;
+	}
+	gpWanPriv->gpon.allocId[channel] = alloc_id;
+	gpWanPriv->activeChannelNum++;
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+}
+
+static int q1000k_gwan_create_gem(u16 gem, u8 channel, u8 type, u16 alloc_id)
+{
+	const struct q1000k_gem_value empty = {0};
+	struct q1000k_gem_value value = { .valid = 1 };
+	GWAN_GemInfo_T info = {0};
+	unsigned long flags;
+	int i, index = -1, ret;
+
+	if (gem > Q1000K_GEM_ID_MAX || type > GPON_MULTICAST_GEM)
+		return -EINVAL;
+	/* Zero is the imported classifier's unset sentinel. OMCC/ONU identity
+	 * needs a separate protocol transaction, not an ordinary data binding.
+	 */
+	if (!gem || !channel ||
+	    (GPON_OMCC_ID != GPON_UNASSIGN_ONU_ID && gem == GPON_OMCC_ID))
+		return -EOPNOTSUPP;
+	if (type == GPON_UNICAST_GEM) {
+		if (alloc_id > Q1000K_ALLOC_ID_MAX ||
+		    (channel >= CONFIG_GPON_10G_MAX_TCONT && channel != GPON_UNKNOWN_CHANNEL))
+			return -EINVAL;
+	} else if (channel != GPON_MULTICAST_CHANNEL) {
+		return -EINVAL;
+	}
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	ret = q1000k_gwan_index_locked(gem);
+	if (ret >= 0) {
+		ret = -EEXIST;
+		goto unlock;
+	}
+	if (type == GPON_UNICAST_GEM) {
+		if (channel == GPON_UNKNOWN_CHANNEL) {
+			for (i = 1; i < CONFIG_GPON_10G_MAX_TCONT; i++)
+				if (gpWanPriv->gpon.allocId[i] == alloc_id) {
+					channel = i;
+					break;
+				}
+		}
+		if (channel < CONFIG_GPON_10G_MAX_TCONT) {
+			if (gpWanPriv->gpon.allocId[channel] != alloc_id) {
+				ret = -ESTALE;
+				goto unlock;
+			}
+			if (q1000k_gwan_retiring_channels & BIT(channel)) {
+				ret = -ESHUTDOWN;
+				goto unlock;
+			}
+		}
+	} else {
+		alloc_id = GPON_10G_UNASSIGN_ALLOC_ID;
+	}
+	for (i = 0; i < CONFIG_GPON_10G_MAX_GEMPORT; i++) {
+		if (gpWanPriv->gpon.gemPort[i].info.valid) {
+			if (gpWanPriv->gpon.gemPort[i].info.portId == gem) {
+				ret = -EEXIST;
+				goto unlock;
+			}
+		} else if (index < 0 && !q1000k_gwan_retiring_gems[i]) {
+			index = i;
+		}
+	}
+	if (index < 0 || gpWanPriv->gpon.gemNumbers >= CONFIG_GPON_10G_MAX_GEMPORT) {
+		ret = -ENOSPC;
+		goto unlock;
+	}
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	value.multicast = type == GPON_MULTICAST_GEM;
+	ret = q1000k_gem_replace(gem, &empty, &value);
+	if (ret) {
+		if (ret == -ESTALE)
+			ret = -EEXIST;
+		goto out;
+	}
+	info.portId = gem;
+	info.allocId = alloc_id;
+	info.channel = channel;
+	info.ani = GPON_MAX_ANI_INTERFACE;
+	info.valid = 1;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	memset(&gpWanPriv->gpon.gemPort[index].stats, 0,
+	       sizeof(gpWanPriv->gpon.gemPort[index].stats));
+	gpWanPriv->gpon.gemPort[index].info = info;
+	gpWanPriv->gpon.gemIdToIndex[gem] = index;
+	gpWanPriv->gpon.gemNumbers++;
+	ret = 0;
+unlock:
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+out:
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
+
+/* The control guard is held; close publication first, then native admission.
+ * Preserve hardware/software bindings until FE/RX/optical retirement exists.
+ */
+static int q1000k_gwan_retire_gem(unsigned int index)
+{
+	unsigned long flags;
+	u8 channel;
+	int ret;
+
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	q1000k_gwan_retiring_gems[index] = true;
+	channel = gpWanPriv->gpon.gemPort[index].info.channel;
+	if (channel < CONFIG_GPON_10G_MAX_TCONT)
+		q1000k_gwan_retiring_channels |= BIT(channel);
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	if (channel && channel < CONFIG_GPON_10G_MAX_TCONT) {
+		q1000k_tcont_quarantine(channel);
+		ret = q1000k_transport_quiesce_channel(channel);
+		if (ret)
+			return ret;
+	}
+	return -EOPNOTSUPP;
+}
+
+static int q1000k_gwan_config_gem(u16 gem, unsigned int type, unsigned int value)
+{
+	GWAN_GemInfo_T *info;
+	unsigned long flags;
+	bool retire = false;
+	int index, ret = 0;
+
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	index = q1000k_gwan_index_locked(gem);
+	if (index < 0) {
+		ret = index;
+		goto unlock;
+	}
+	info = &gpWanPriv->gpon.gemPort[index].info;
+	if (q1000k_gem_faulted()) {
+		ret = -EIO;
+		goto unlock;
+	}
+	if (q1000k_gwan_retiring_gems[index] ||
+	    (info->channel < CONFIG_GPON_10G_MAX_TCONT &&
+	     (q1000k_gwan_retiring_channels & BIT(info->channel)))) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	switch (type) {
+	case ENUM_CFG_NETIDX:
+		if (value > GPON_MAX_ANI_INTERFACE)
+			ret = -EINVAL;
+		else if (value == info->ani)
+			break;
+		else if (info->ani == GPON_MAX_ANI_INTERFACE)
+			info->ani = value;
+		else if (value == GPON_MAX_ANI_INTERFACE)
+			retire = true;
+		else
+			ret = -EOPNOTSUPP;
+		break;
+	case ENUM_CFG_CHANNEL:
+		if (!value || value >= CONFIG_GPON_10G_MAX_TCONT) {
+			if (value != GPON_MULTICAST_CHANNEL || value != info->channel)
+				ret = -EINVAL;
+		} else if (value == info->channel) {
+			if (gpWanPriv->gpon.allocId[value] != info->allocId)
+				ret = -ESTALE;
+		} else if (info->ani != GPON_MAX_ANI_INTERFACE ||
+			   info->channel != GPON_UNKNOWN_CHANNEL) {
+			ret = -EOPNOTSUPP;
+		} else if (gpWanPriv->gpon.allocId[value] != info->allocId) {
+			ret = -ESTALE;
+		} else if (q1000k_gwan_retiring_channels & BIT(value)) {
+			ret = -ESHUTDOWN;
+		} else {
+			info->channel = value;
+		}
+		break;
+	case ENUM_CFG_ENCRYPTION:
+		/* Key selection/timing needs its own security transaction. */
+		ret = value == NO_ENCRYPTION && !info->rxEncrypt && !info->txEncrypt ?
+			0 : -EOPNOTSUPP;
+		break;
+	case ENUM_CFG_LOOPBACK:
+		ret = value == 0 && !info->rxLb ? 0 : -EOPNOTSUPP;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+unlock:
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	if (retire)
+		ret = q1000k_gwan_retire_gem(index);
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
+
+static int q1000k_gwan_remove_gem(u16 gem)
+{
+	unsigned long flags;
+	int index, ret;
+
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	spin_lock_irqsave(&q1000k_gwan_lock, flags);
+	index = q1000k_gwan_index_locked(gem);
+	spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+	ret = index < 0 ? index : q1000k_gwan_retire_gem(index);
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
+
+static int q1000k_gwan_remove_all_gems(void)
+{
+	unsigned long flags;
+	bool valid;
+	int i, err, ret = 0;
+
+	if (atomic_cmpxchg(&q1000k_tcont_config_busy, 0, 1))
+		return -EBUSY;
+	for (i = 0; i < CONFIG_GPON_10G_MAX_GEMPORT; i++) {
+		spin_lock_irqsave(&q1000k_gwan_lock, flags);
+		valid = gpWanPriv->gpon.gemPort[i].info.valid;
+		spin_unlock_irqrestore(&q1000k_gwan_lock, flags);
+		if (!valid)
+			continue;
+		err = q1000k_gwan_retire_gem(i);
+		if (!ret || (ret == -EOPNOTSUPP && err != -EOPNOTSUPP))
+			ret = err;
+	}
+	atomic_set_release(&q1000k_tcont_config_busy, 0);
+	return ret;
+}
