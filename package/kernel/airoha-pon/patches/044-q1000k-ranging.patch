From: Q1000K development <q1000k@localhost>
Subject: [PATCH] xpon: defer ranging to verified physical resynchronization

--- a/xpon-en757x/xpon_10g/src/gpon/gpon_ploam.c
+++ b/xpon-en757x/xpon_10g/src/gpon/gpon_ploam.c
@@ -642,6 +642,31 @@
 **____________________________________________________________________________*/
 static int ploam_recv_ranging_time(PLOAM_RAW_Ranging_Time_T *pRangingMsg)
 {
+#ifdef Q1000K_PON_IDENTITY
+	u16 dest;
+	u32 delay;
+	bool absolute, broadcast;
+
+	if (!pRangingMsg)
+		return -EINVAL;
+	if (!q1000k_protocol_owned())
+		return -EPERM;
+	if (GPON_CURR_STATE != GPON_10G_STATE_O4 && GPON_CURR_STATE != GPON_10G_STATE_O5)
+		return -EINVAL;
+	absolute = pRangingMsg->raw.eqd_mode == PLOAM_EQD_ABSOLUTE;
+	dest = (u16)pRangingMsg->raw.dest_id[0] << 8 | pRangingMsg->raw.dest_id[1];
+	broadcast = dest == PLOAM_BROADCAST_ADDR || dest == PLOAM_XGSPON_BROADCAST_ADDR ||
+		dest == PLOAM_XGSPON_BROADCAST_ADDR_NOKIA;
+	if ((absolute && dest != GPON_ONU_ID) ||
+	    (!absolute && dest != GPON_ONU_ID && !broadcast) ||
+	    (GPON_CURR_STATE == GPON_10G_STATE_O4 && !absolute))
+		return -EINVAL;
+	delay = (u32)pRangingMsg->raw.eqd_value[0] << 24 |
+		(u32)pRangingMsg->raw.eqd_value[1] << 16 |
+		(u32)pRangingMsg->raw.eqd_value[2] << 8 | pRangingMsg->raw.eqd_value[3];
+	return q1000k_omci_ranging(delay, absolute, pRangingMsg->raw.eqd_adjust == PLOAM_EQD_NEGATIVE,
+		pRangingMsg->raw.seq_no, !broadcast && (GPON_CURR_STATE == GPON_10G_STATE_O4 || delay));
+#else
 	uint msgDestId = 0 ;
 	uint newEqd = 0;
 #if defined(TCSUPPORT_CPU_AN7583)
@@ -799,6 +824,8 @@
 	}
 #endif
 	return 0 ;
+
+#endif
 }
 /*______________________________________________________________________________
 **	function name
--- a/xpon-en757x/xpon_10g/src/gpon/gpon_act.c
+++ b/xpon-en757x/xpon_10g/src/gpon/gpon_act.c
@@ -535,8 +535,22 @@
 		goto out;
 	}
 	if (new_state == GPON_10G_STATE_O5) {
+		ret = q1000k_omci_ranged();
+		if (ret)
+			goto out;
 		ret = q1000k_omci_registration_keys();
 		if (ret)
+			goto out;
+	}
+	if (new_state == GPON_10G_STATE_O2_3 &&
+	    GPON_CURR_STATE != GPON_10G_STATE_O1 && GPON_CURR_STATE != GPON_10G_STATE_O2_3) {
+		/* Registration timeout/restart cannot retain the old ONU namespace. */
+		ret = q1000k_omci_reset(false, false);
+		goto out;
+	}
+	if (new_state == GPON_10G_STATE_O5) {
+		ret = q1000k_protocol_timer_delete(&gpGponPriv->to1_timer, true, false);
+		if (ret < 0)
 			goto out;
 	}
 	ret = q1000k_mac_activation_set(new_state);
