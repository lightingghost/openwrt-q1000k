 /*****************************************************************
  ****  N P    S C U    a c c e s s ********************************
  ******************************************************************/
+#ifdef AN7581_OPENWRT_SCU
+static struct regmap *an7581_np_scu, *an7581_chip_scu;
+
+static u32 an7581_scu_read(struct regmap *map, u32 size, u32 reg)
+{
+	u32 value;
+
+	if (map && !(reg & 3) && reg <= size - 4 &&
+	    !regmap_read(map, reg, &value))
+		return value;
+	pr_err_ratelimited("an7581-pon: invalid/failed SCU read %#x\n", reg);
+	return ~0U;
+}
+
+static void an7581_scu_update(struct regmap *map, u32 size, u32 reg,
+			      u32 mask, u32 value)
+{
+	int ret;
+
+	if (map && !(reg & 3) && reg <= size - 4) {
+		/* Full writes may target strobes/W1C: do not add an implicit read. */
+		ret = mask == ~0U ? regmap_write(map, reg, value) :
+			regmap_update_bits(map, reg, mask, value & mask);
+		if (!ret)
+			return;
+	}
+	pr_err_ratelimited("an7581-pon: invalid/failed SCU update %#x\n", reg);
+}
+#endif
+
