 u32 get_np_scu_data(u32 reg)
 {
+#ifdef AN7581_OPENWRT_SCU
+	return an7581_scu_read(an7581_np_scu, 0x970, reg);
+#else
 	return readl(ecnt_scu->npScu_base + reg);
+#endif
 }
 
