Subject: [PATCH] xpon: trace OMCI admission without capturing private payloads

--- a/xpon-en757x/xpon_10g/src/xpondrv.c
+++ b/xpon-en757x/xpon_10g/src/xpondrv.c
@@ -1,3 +1,4 @@
+#include <q1000k_trace.h>
 #include "common/q1000k_omci_backend.h"
 #include "common/q1000k_services.h"
 #include "common/q1000k_packet.h"
@@ -457,7 +458,11 @@
 	dev = gpWanPriv->pPonNetDev[PWAN_IF_DATA];
 	if (dev)
 		priv = netdev_priv(dev);
+	if (skb && msg && msg_len >= 16 && (((u32 *)msg)[0] & BIT(8)))
+		q1000k_trace(QT_CONTROL, 30, 0, ((u32 *)msg)[0], skb->len, ((u32 *)msg)[2], 0);
 	ret = q1000k_pwan_rx_prepare(skb, msg, msg_len, len);
+	if (msg && msg_len >= 16 && (((u32 *)msg)[0] & BIT(8)))
+		q1000k_trace(QT_CONTROL, 31, ret, len, msg_len, 0, 0);
 	if (ret)
 		goto drop;
 	first = ((u32 *)msg)[0];
