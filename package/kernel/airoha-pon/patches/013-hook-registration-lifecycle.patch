From: Q1000K development <q1000k@localhost>
Subject: [PATCH] ecnt: serialize hook removal and node reuse across RCU grace periods

Remove the unregister-by-ID RCU self-deadlock, handle partial-init removal,
and prevent duplicate registration or node reuse racing an in-flight reader.
Registration/removal are process-context operations; dispatch remains RCU.

--- a/bsp/core/ecnt_hook.c
+++ b/bsp/core/ecnt_hook.c
@@ -94,7 +94,10 @@
 *                  P R I V A T E   D A T A
 *************************************************************************
 */
-static DEFINE_SPINLOCK(ecnt_hook_lock);
+/* Registration and removal are process-context operations. Keep the writer
+ * mutex through the RCU grace period so removed nodes cannot be reused early.
+ */
+static DEFINE_MUTEX(ecnt_hook_mutex);
 unsigned int hook_id = 0;
 
 /************************************************************************
@@ -204,31 +207,24 @@
 //		0: fail
 //		1: success
 ******************************************************************************/
-int set_ecnt_hookfn_execute_or_not(unsigned int maintype, unsigned int subtype, unsigned int hook_id, unsigned int is_execute)
-{
-	struct list_head* ptr = &ecnt_hooks[maintype][subtype];
-	
-	if((maintype >= ECNT_NUM_MAINTYPE) || (subtype >= ECNT_MAX_SUBTYPE)){
-		printk("set_ecnt_hookfn_execute_or_not fail, max maintype %d, max subtype %d\n", ECNT_NUM_MAINTYPE, ECNT_MAX_SUBTYPE);
+int set_ecnt_hookfn_execute_or_not(unsigned int maintype, unsigned int subtype,
+				unsigned int id, unsigned int is_execute)
+{
+	struct ecnt_hook_ops *elem;
+	int found = 0;
+
+	if (maintype >= ECNT_NUM_MAINTYPE || subtype >= ECNT_MAX_SUBTYPE)
 		return 0;
-	}
-	if(list_empty(&ecnt_hooks[maintype][subtype]))
-		return 0;
-	
-	struct ecnt_hook_ops *elem;
 	rcu_read_lock();
-	elem = list_entry_rcu(ptr, struct ecnt_hook_ops, list);
-	//list_for_each_continue_rcu(pos, &ecnt_hooks[maintype][subtype]){
-	list_for_each_entry_continue_rcu(elem, &ecnt_hooks[maintype][subtype], list){
-		if(elem->hook_id == hook_id){
-			WRITE_ONCE(elem->is_execute, is_execute);
-			rcu_read_unlock();
-			return 1;
-		}
+	list_for_each_entry_rcu(elem, &ecnt_hooks[maintype][subtype], list) {
+		if (elem->hook_id != id)
+			continue;
+		WRITE_ONCE(elem->is_execute, is_execute);
+		found = 1;
+		break;
 	}
 	rcu_read_unlock();
-
-	return 0;
+	return found;
 }
 EXPORT_SYMBOL(set_ecnt_hookfn_execute_or_not);
 
@@ -244,33 +240,22 @@
 //		1: success
 ******************************************************************************/
 
