-		printk("get_ecnt_hookfn fail, max maintype %d, max subtype %d\n", ECNT_NUM_MAINTYPE, ECNT_MAX_SUBTYPE);
+int get_ecnt_hookfn(unsigned int maintype, unsigned int subtype)
+{
+	struct ecnt_hook_ops *elem;
+	int count = 0;
+
