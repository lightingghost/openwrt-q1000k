+#else
 	uint msgDestId = 0 ;
 	
 	GPON_PLOAM_MSG_RAW(MSG_OAM,"PLOAM: Receive key control ploam message:", pKeyControl->value,PLOAM_DOWN_MSG_LENGTH);
@@ -1159,6 +1264,8 @@
         PON_MSG((MSG_OAM), "PLOAM: ignore key control ploam in state O:%d \n",GPON_CURR_STATE) ;
 	}
 	return 0 ;
+
+#endif
 }
