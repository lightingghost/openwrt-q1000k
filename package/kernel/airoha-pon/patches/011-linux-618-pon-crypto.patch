+int gpon_aes_cmac_encrypt(struct crypto_lskcipher *tfm, const u8 *key,
+			  const u8 *data, size_t data_len, u8 *mac)
+{
+	const u8 *addr[] = { data };
+	const size_t len[] = { data_len };
+	unsigned long flags;
+	int ret;
+
+	/* The shared transform must not change keys during another request. */
+	spin_lock_irqsave(&gpon_cmac_lock, flags);
+	ret = aes_128_cmac_vector(tfm, key, ARRAY_SIZE(addr), addr, len, mac);
+	spin_unlock_irqrestore(&gpon_cmac_lock, flags);
+	return ret;
