From: Q1000K development <q1000k@localhost>
Subject: [PATCH] xpon: connect authenticated OMCI and native service provider

--- a/xpon-en757x/xpon_10g/src/xpondrv.c
+++ b/xpon-en757x/xpon_10g/src/xpondrv.c
@@ -1,3 +1,6 @@
+#include "common/q1000k_omci_backend.h"
+#include "common/q1000k_services.h"
+#include "common/q1000k_packet.h"
 #include "common/q1000k_protocol_compat.h"
 #ifdef Q1000K_PON_IDENTITY
 #include <an7581_xpon.h>
@@ -436,12 +439,35 @@
 	int ret;
 
 	rcu_read_lock();
+#ifdef Q1000K_PON_IDENTITY
+	if (xpon_is_ready() && !q1000k_pwan_rx_prepare(skb, msg, msg_len, len)) {
+		u32 first = ((u32 *)msg)[0];
+		u16 gem = (first >> 14) & 0xffff;
+		struct net_device *dev = gpWanPriv->pPonNetDev[PWAN_IF_DATA];
+
+		if (first & BIT(8)) {
+			q1000k_omci_receive(skb, gem, !!(first & BIT(11)));
+			ret = 0;
+		} else if (!(first & (BIT(11) | BIT(12) | BIT(13))) && dev &&
+			   !q1000k_services_rx(skb, gem)) {
+			skb->ip_summed = CHECKSUM_NONE;
+			skb->protocol = eth_type_trans(skb, dev);
+			netif_rx(skb);
+			ret = 0;
+		} else {
+			dev_kfree_skb_any(skb);
+		}
+	} else {
+		dev_kfree_skb_any(skb);
+	}
+#else
 	if (xpon_is_ready())
 		ret = pwan_cb_rx_packet(msg, msg_len, skb, len);
 	else {
 		dev_kfree_skb_any(skb);
 		ret = -ENODEV;
 	}
+#endif
 	rcu_read_unlock();
 	return ret;
 }
@@ -1176,6 +1202,7 @@
 	.irq = xpon_protocol_irq,
 	.phy = xpon_protocol_phy,
 	.fault = xpon_protocol_fault,
+	.control = q1000k_omci_control,
 };
 #endif
 
@@ -1299,6 +1326,9 @@
 		xpon_owned.protocol = false;
 	}
 #endif
+#ifdef Q1000K_PON_IDENTITY
+	q1000k_omci_backend_cleanup();
+#endif
 	/* Keep native DMA alive until protocol producers and the physical
 	 * pipeline are drained. Closed ready gates reject new callbacks. */
 	/* In-flight RX/event wrappers may have observed ready before closure. */
@@ -1447,6 +1475,11 @@
 	if (ret)
 		goto fail;
 	xpon_owned.gpon = true;
+#ifdef Q1000K_PON_IDENTITY
+	ret = q1000k_omci_backend_init(gpWanPriv->pPonNetDev[PWAN_IF_DATA]);
+	if (ret)
+		goto fail;
+#endif
 #ifndef Q1000K_PON_IDENTITY
 	ret = xpondrv_qdma_init();
 	if (ret)
--- a/xpon-en757x/xpon_10g/src/pwan/xpon_netif.c
+++ b/xpon-en757x/xpon_10g/src/pwan/xpon_netif.c
@@ -1,3 +1,4 @@
+#include "common/q1000k_services.h"
 #include "common/q1000k_protocol_compat.h"
 /***************************************************************
 Copyright Statement:
@@ -291,19 +292,26 @@
 
 int pwan_net_start_xmit(struct sk_buff *skb, struct net_device *dev)
 {
-	int ret;
-
 #ifdef Q1000K_PON_IDENTITY
-	/* Cover the binding snapshot through native admission, including calls
-	 * from the vendor public hook and receive loopback path.
-	 */
+	PWAN_NetPriv_T *priv = netdev_priv(dev);
+	unsigned int bytes = skb->len;
+	int ret = -ENOLINK;
+
 	rcu_read_lock();
-#endif
-	ret = pwan_net_start_xmit_impl(skb, dev);
-#ifdef Q1000K_PON_IDENTITY
+	if (xpon_is_ready() && priv->netIdx == PWAN_IF_DATA)
+		ret = q1000k_services_tx(skb);
+	if (ret) {
+		priv->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+	} else {
+		priv->stats.tx_packets++;
+		priv->stats.tx_bytes += bytes;
+	}
 	rcu_read_unlock();
-#endif
-	return ret;
+	return NETDEV_TX_OK;
+#else
+	return pwan_net_start_xmit_impl(skb, dev);
+#endif
 }
 
 static int pwan_net_start_xmit_impl(struct sk_buff *skb, struct net_device *dev)
