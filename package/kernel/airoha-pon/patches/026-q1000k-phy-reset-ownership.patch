 static struct regmap *an7581_np_scu, *an7581_chip_scu;
 
+int an7581_pon_wan_get(u32 *mode)
+{
+	u32 value;
+	int ret;
+
+	if (!mode)
+		return -EINVAL;
+	if (!an7581_np_scu)
+		return -ENODEV;
+	ret = regmap_read(an7581_np_scu, 0x70, &value);
+	if (ret)
+		return ret;
+	if (value == ~0U)
+		return -EIO;
+	*mode = value & 0xff;
+	return 0;
+}
+EXPORT_SYMBOL(an7581_pon_wan_get);
+
+static int an7581_pon_scu_update(u32 reg, u32 mask, u32 value)
+{
+	u32 actual;
+	int ret;
+
+	if (!an7581_np_scu)
+		return -ENODEV;
+	ret = regmap_update_bits(an7581_np_scu, reg, mask, value);
+	if (!ret)
+		ret = regmap_read(an7581_np_scu, reg, &actual);
+	return ret ? ret : actual == ~0U || (actual & mask) != value ? -EIO : 0;
+}
+
+int an7581_pon_wan_set(u32 mode)
+{
+	if (mode != 10 && mode != 17)
+		return -EINVAL;
+	return an7581_pon_scu_update(0x70, 0xff, mode);
+}
+EXPORT_SYMBOL(an7581_pon_wan_set);
+
+int an7581_pon_pbus_enable(void)
+{
+	return an7581_pon_scu_update(0x92c, BIT(2), 0);
+}
+EXPORT_SYMBOL(an7581_pon_pbus_enable);
+
