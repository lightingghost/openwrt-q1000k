@@ -1012,6 +1015,9 @@
 
 int an7581_pon_mac_scu_reset(const void *in, void *out)
 {
+#ifdef Q1000K_PON_IDENTITY
+	return an7581_xpon_reset();
+#else
 	uint32_t Raw = 0;
 
