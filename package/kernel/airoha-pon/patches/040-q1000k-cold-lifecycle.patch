--- a/xpon-en757x/xpon_10g/src/gpon/gpon_act.c
+++ b/xpon-en757x/xpon_10g/src/gpon/gpon_act.c
@@ -46,6 +46,10 @@
 #include <linux/timer.h>
 #include <linux/jiffies.h>
 #include "common/xpon_global.h"
+#ifdef Q1000K_PON_IDENTITY
+#include "common/q1000k_mac_cold.h"
+#include <q1000k_phy_api.h>
+#endif
 #include "common/xpon_api.h"
 #include <common/xpon_led.h>
 #include "common/phy_if_wrapper.h"
@@ -510,6 +514,47 @@
 **____________________________________________________________________________*/
 void gpon_act_change_state(const uint new_state)
 {
+#ifdef Q1000K_PON_IDENTITY
+	int token = q1000k_protocol_enter(), ret;
+
+	if (token < 0) {
+		q1000k_protocol_fail(token);
+		return;
+	}
+	if (new_state == GPON_10G_STATE_O1 || new_state == GPON_10G_STATE_O7) {
+		ret = q1000k_omci_reset(new_state == GPON_10G_STATE_O7, false);
+		goto out;
+	}
+	/* XGS-only state changes are checked before software publication.
+	 * O6 fast recovery reuses keys/FIFOs without a complete drain and is
+	 * replaced by cold registration on PHY loss.
+	 */
+	if (new_state != GPON_10G_STATE_O2_3 && new_state != GPON_10G_STATE_O4 &&
+	    new_state != GPON_10G_STATE_O5) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	ret = q1000k_mac_activation_set(new_state);
+	if (!ret && new_state == GPON_10G_STATE_O2_3)
+		ret = q1000k_phy_set_tx(true);
+	if (ret)
+		goto out;
+	GPON_CURR_STATE = new_state;
+	if (new_state == GPON_10G_STATE_O4) {
+		GPON_START_TIMER(gpGponPriv->to1_timer, gpGponPriv->gponCfg.to1Timer);
+	} else if (new_state == GPON_10G_STATE_O5) {
+		GPON_START_TIMER(gpGponPriv->hardware_timer, gpGponPriv->gponCfg.hardware_timer);
+		gpon_clear_alarmBit(DACT_INDEX);
+		gpGponPriv->activationCnt++;
+	}
+	xmcs_report_event(XMCS_EVENT_TYPE_GPON, XMCS_EVENT_GPON_STATE_CHANGE, new_state);
+	tasklet_schedule(&taskLedConfig);
+	q1000k_omci_state();
+out:
+	if (ret)
+		q1000k_protocol_fail(ret);
+	q1000k_protocol_leave(token);
+#else
 	REG_ACTIVATION_ST xgponActState;	
 	uint lastState = 0;
 	ulong flags = 0;
@@ -627,6 +672,8 @@
 #endif
 
 	PON_MSG(MSG_ACT, "Change the current state: O%d. Last State:O%d\n", GPON_CURR_STATE, lastState) ; 
+
+#endif
 }
