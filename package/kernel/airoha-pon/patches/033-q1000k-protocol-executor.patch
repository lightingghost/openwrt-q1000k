From: Q1000K development <q1000k@localhost>
Subject: [PATCH] serialize MAC timers, tasks, PHY events and owned IRQ

Use a bounded process executor for AN7581, retaining events across service
pauses. Keep the platform interrupt disabled until its deferred callback
acknowledges the MAC. Drain the executor before releasing callback state.

--- a/xpon-en757x/xpon_10g/Makefile
+++ b/xpon-en757x/xpon_10g/Makefile
@@ -74,7 +74,7 @@
 
 ifneq ($(TCSUPPORT_CPU_EN7581),)
 ifeq ($(TCSUPPORT_CPU_AN7583),)
-TOTAL_OBJ += $(SRCDIR)/q1000k_identity.o $(SRCDIR)/q1000k_packet.o $(SRCDIR)/q1000k_omci.o $(SRCDIR)/q1000k_transport.o $(SRCDIR)/q1000k_tcont.o $(SRCDIR)/q1000k_gem.o $(SRCDIR)/q1000k_pipeline.o $(SRCDIR)/q1000k_auth.o
+TOTAL_OBJ += $(SRCDIR)/q1000k_identity.o $(SRCDIR)/q1000k_packet.o $(SRCDIR)/q1000k_omci.o $(SRCDIR)/q1000k_transport.o $(SRCDIR)/q1000k_tcont.o $(SRCDIR)/q1000k_gem.o $(SRCDIR)/q1000k_pipeline.o $(SRCDIR)/q1000k_auth.o $(SRCDIR)/q1000k_protocol.o
 endif
 endif
 
