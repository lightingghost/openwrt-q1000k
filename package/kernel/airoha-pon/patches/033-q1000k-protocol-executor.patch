@@ -514,7 +515,16 @@
 	char same_state = 0;
 	REG_CUR_KIDX gponCurKeyIdx;
 
+#ifdef Q1000K_PON_IDENTITY
+	int token = q1000k_protocol_enter();
+
+	if (token < 0) {
+		q1000k_protocol_fail(token);
+		return;
+	}
+#else
 	spin_lock_irqsave(&gpGponPriv->act_lock, flags) ;
