+#else
 	spin_unlock_irqrestore(&gpGponPriv->act_lock, flags) ;
+#endif
 
 	PON_MSG(MSG_ACT, "Change the current state: O%d. Last State:O%d\n", GPON_CURR_STATE, lastState) ; 
 }
