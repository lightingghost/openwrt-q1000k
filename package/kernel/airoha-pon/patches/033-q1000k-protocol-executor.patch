 	if (new_state == GPON_CURR_STATE){
 	   PON_MSG(MSG_ACT, "PLOAM: State non-change: original = O%d  new = O%d\n",GPON_CURR_STATE, new_state) ;
@@ -608,7 +618,11 @@
 
 	gpon_act_increase_LODS_event(lastState,new_state);
 	
+#ifdef Q1000K_PON_IDENTITY
