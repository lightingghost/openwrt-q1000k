+/* Runtime state and event dispatch retained from gpon_proc.c. The legacy
+ * writable debug commands are deliberately not exposed through this interface.
+ */
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include "common/xpon_global.h"
+#include "common/phy_if_wrapper.h"
+#include "gpon/gpon_dvt.h"
+#include "gpon/gpon_security.h"
+#include <ecnt_hook/ecnt_hook_pon_mac.h>
+#include "gpon/gpon_recovery.h"
+#include "gpon/gpon_runtime.h"
+
+/* 0: slow mode,  1: fast mode */
+int xgpon_fast_mode_flag = 0;
+
+int drop_print_flag =0;
+uint bwmap_print_flag = 0x7fff;
+uint sw_resync_flag = 1;
+int max_cnt = 20;
+int omciMicErrSwCnt = 0;
+
+#if defined(TCSUPPORT_CPU_EN7581)
+int gpon_tod_adjust = 0;
+uint hw_gem_config = 1;
+#else
+uint hw_gem_config = 0;
+#endif
+
+RDK_GTC_Dbg_T rdk_gtc_dbg = {};
+RDK_MIC_Dbg_T rdk_mic_err_dbg = {};
+
+
+int omciIkIdxExchange = 0;
+int dropCpuTxPktsFlag = 0;
+int xpon_mac_print_open =0;
+
+/*************for NG2 channel swap debug************/
+int ng2_mon_not_gnt = 1;
+int ng2_tun_resp_key = 1;
+int ng2_o4_to_09 = 0;
+int ng2_o8_to_05 = 0;
+int ng2_no_rollback = 0;
+int ng2_man_set_09 = 0;
+int ng2_set_state = 0;
+int ng2_ignore_disable = 0;
+
+
+static struct proc_dir_entry *gpon_proc_dir;
+
+void XGPON_MAC_EVENT_HANDLER(PON_PHY_Event_data_t *event)
+{
+	struct xpon_mac_hook_data_s data = {
+		.src_module = XPON_PHY_MODULE,
+		.pEvent = event,
+	};
+
+	if (!event)
+		return;
+	if (__ECNT_HOOK(ECNT_XPON_MAC, ECNT_XPON_MAC_HOOK,
+		       (struct ecnt_data *)&data) == ECNT_HOOK_ERROR)
+		pr_err_ratelimited("xpon: PHY event %d dispatch failed\n", event->id);
+}
+
+static int gpon_status_show(struct seq_file *seq, void *unused)
+{
+	if (!gpGponPriv || !gpPonSysData)
+		return -ENODEV;
+
+	/* Cached software state only: never read or clear hardware counters here. */
+	seq_printf(seq, "state=%u\nlink_status=%u\nomci_mic_errors=%d\n",
+		   READ_ONCE(gpGponPriv->state),
+		   READ_ONCE(gpPonSysData->sysLinkStatus),
+		   READ_ONCE(omciMicErrSwCnt));
+	return 0;
+}
+
+int xpon_proc_init(void)
+{
+	if (gpon_proc_dir)
+		return -EBUSY;
+	gpon_proc_dir = proc_mkdir("xgpon", NULL);
+	if (!gpon_proc_dir)
+		return -ENOMEM;
+	if (!proc_create_single("status", 0444, gpon_proc_dir, gpon_status_show)) {
+		proc_remove(gpon_proc_dir);
+		gpon_proc_dir = NULL;
+		return -ENOMEM;
+	}
+	return 0;
+}
+
+int xpon_proc_dest(void)
+{
+	proc_remove(gpon_proc_dir);
+	gpon_proc_dir = NULL;
+	return 0;
+}
