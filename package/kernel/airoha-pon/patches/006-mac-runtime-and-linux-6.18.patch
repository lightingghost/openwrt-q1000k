@@ -1,5 +1,6 @@
 KERNELDIR=$(KERNEL_DIR)
-ccflags-y += -DWAN2LAN
+# WAN-to-LAN debug mirroring calls the absent OEM Ethernet macSend API.
+# Leave it disabled; the upstream Ethernet driver owns LAN transmission.
 
