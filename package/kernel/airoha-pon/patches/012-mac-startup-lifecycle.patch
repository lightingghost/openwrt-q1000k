+static int xpondrv_rx_packet(void *msg, uint msg_len, struct sk_buff *skb, uint len)
+{
+	int ret;
+
+	rcu_read_lock();
+	if (xpon_is_ready())
+		ret = pwan_cb_rx_packet(msg, msg_len, skb, len);
+	else {
+		dev_kfree_skb_any(skb);
+		ret = -ENODEV;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+static int xpondrv_qdma_event(QDMA_EventType_t event)
+{
+	int ret = -ENODEV;
+
+	rcu_read_lock();
+	if (xpon_is_ready())
+		ret = pwan_cb_event_handler(event);
+	rcu_read_unlock();
+	return ret;
+}
