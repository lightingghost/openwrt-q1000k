+void gpon_act_stop_timers(void)
+{
+	/* Shutdown prevents a running callback from rearming its timer. */
+	timer_shutdown_sync(&gpGponPriv->to1_timer);
+	timer_shutdown_sync(&gpGponPriv->to2_timer);
+	timer_shutdown_sync(&gpGponPriv->hardware_timer);
+#if defined(TCSUPPORT_CPU_AN7583)
+	timer_shutdown_sync(&gpGponPriv->fe_chn_done_timer);
+#endif
+	if (NGPON2_MODE) {
+		timer_shutdown_sync(&gpGponPriv->to3_timer);
+		timer_shutdown_sync(&gpGponPriv->to4_timer);
+		timer_shutdown_sync(&gpGponPriv->to5_timer);
+		timer_shutdown_sync(&gpGponPriv->toZ_timer);
+	}
+}
+
 void gpon_act_deinit(void)
 {
+	gpon_act_stop_timers();
+	/* Protocol tasklets must also be drained before the LED consumer. */
 	tasklet_kill(&taskLedConfig);
