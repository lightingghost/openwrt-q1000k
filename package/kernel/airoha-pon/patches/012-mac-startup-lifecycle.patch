+void gpon_stop_work(void)
+{
+	if (!gpon_initialized || gpon_work_stopped)
+		return;
+	gpon_work_stopped = true;
+	/* Shut down every timer producer before killing its tasklet consumers.
+	 * Protocol tasklets can themselves schedule the LED/WAN tasklets.
+	 */
+	timer_shutdown_sync(&gpGponPriv->silence_timer);
+	timer_shutdown_sync(&gpGponPriv->gponSecurity.TK4_timer);
+	timer_shutdown_sync(&gpGponPriv->gponSecurity.TK5_timer);
+	gpon_act_stop_timers();
+	ploam_deinit();
+	gpon_act_deinit();
+}
