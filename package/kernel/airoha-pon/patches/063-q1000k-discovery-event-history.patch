+/* Fresh module session only; retain the production default and all other
+ * fault/ranging protections. Two explicit values keep the comparison bounded. */
+static int q1000k_sn_limit_set(const char *value, const struct kernel_param *kp)
+{
+	int n, ret = kstrtoint(value, 0, &n);
+	if (ret) return ret;
+	if (n != 20 && n != 40) return -EINVAL;
+	return param_set_int(value, kp);
+}
+static const struct kernel_param_ops q1000k_sn_limit_ops = {
+	.set = q1000k_sn_limit_set, .get = param_get_int,
+};
