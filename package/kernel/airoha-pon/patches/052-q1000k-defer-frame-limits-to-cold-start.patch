 #ifndef Q1000K_PON_IDENTITY
+	stage = "epon-init";
 	ret = epon_init();
 	if (ret)
 		goto fail;
 	xpon_owned.epon = true;
 #endif
+	stage = "gpon-init";
 	ret = gpon_init();
 	if (ret)
 		goto fail;
 	xpon_owned.gpon = true;
 #ifdef Q1000K_PON_IDENTITY
+	stage = "omci-backend";
 	ret = q1000k_omci_backend_init(gpWanPriv->pPonNetDev[PWAN_IF_DATA]);
 	if (ret)
 		goto fail;
 #endif
 #ifndef Q1000K_PON_IDENTITY
+	stage = "native-attachment";
