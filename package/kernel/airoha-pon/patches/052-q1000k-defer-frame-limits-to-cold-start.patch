Subject: [PATCH] defer Q1000K frame limits until the cold drain transaction

WAN netdevice creation precedes physical drain. Changing the native frame
limits there returns EBUSY on an ordinary cold boot. The cold transaction
already installs the same limits after verified drain and epoch reset. Keep
Keep legacy startup for other targets. Name failures without logging
identity.

---

--- a/xpon-en757x/xpon_10g/src/pwan/gpon_wan.c
+++ b/xpon-en757x/xpon_10g/src/pwan/gpon_wan.c
@@ -2061,19 +2061,9 @@
 }
 /*****************************************************************************
 ******************************************************************************/
+#ifndef Q1000K_PON_IDENTITY
 static int gwan_channel_init(void)
 {
-#ifdef Q1000K_PON_IDENTITY
-	struct airoha_pon_port_config old, config;
-	int ret = q1000k_transport_get_port_config(&old);
-
-	if (ret)
-		return ret;
-	config = old;
-	config.min_len = GPON_PACKET_LEN_LOWER_LIMIT;
-	config.max_len = GPON_PACKET_LEN_UPPER_LIMIT;
-	return q1000k_transport_configure_port(&old, &config);
-#else
 	int ret = feDevGdm2Cdm2Stop(XPON_RESET_HOLD_ON);
 
 	if (!ret)
@@ -2082,8 +2072,8 @@
 		ret = FE_API_SET_PACKET_LENGTH(FE_GDM_SEL_GDMA2,
 			GPON_PACKET_LEN_UPPER_LIMIT, GPON_PACKET_LEN_LOWER_LIMIT);
 	return ret;
-#endif
-}
+}
+#endif
 /*****************************************************************************
 ******************************************************************************/
 GPON_TRAFFIC_STATUS_t gwan_get_traffic_status(void){
@@ -2152,12 +2142,17 @@
 		gwan_deinit();
 		return ret;
 	}
+	/* Q1000K frame limits belong to the later cold transaction, after
+	 * physical drain. Native attachment alone has not stopped RX.
+	 */
+#ifndef Q1000K_PON_IDENTITY
 	ret = gwan_channel_init();
 	if (ret) {
 		pwan_delete_net_interface(PWAN_IF_OMCI);
 		gwan_deinit();
 		return ret;
 	}
+#endif
 	return 0 ;	
 }
