 	gpPonSysData->xpon_daemon.task = kthread_run(xpon_daemon, NULL, "xpon_daemon");
 	if (IS_ERR(gpPonSysData->xpon_daemon.task)) {
 		ret = PTR_ERR(gpPonSysData->xpon_daemon.task);
@@ -1583,6 +1598,7 @@
 		goto fail;
 	}
 #ifdef Q1000K_PON_IDENTITY
+	stage = "protocol-status";
