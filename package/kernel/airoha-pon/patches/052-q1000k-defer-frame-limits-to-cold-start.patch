+	stage = "globals";
 	ret = xpondrv_init_global_data();
 	if (ret)
 		goto fail;
 	xpon_owned.globals = true;
 	omci_oam_monitor_init(&gpPonSysData->Omci_Oam_Monitor);
 	xpon_owned.monitor = true;
+	stage = "wan-init";
 	ret = pwan_init();
 	if (ret)
 		goto fail;
 	xpon_owned.wan = true;
+	stage = "mci-init";
 	ret = xpon_mci_init();
 	if (ret)
 		goto fail;
