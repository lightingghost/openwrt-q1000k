 	ret = q1000k_protocol_start();
 	if (ret)
 		goto fail;
@@ -1609,7 +1627,7 @@
 	pr_info("%s\n", MODULE_VERSION_10GXPONMAC);
 	return 0;
 fail:
-	pr_err("xpon: initialization failed: %d\n", ret);
