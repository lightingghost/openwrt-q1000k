 #endif
+	stage = "proc-init";
 	ret = xpon_proc_init();
 	if (ret)
 		goto fail;
 	xpon_owned.proc = true;
+	stage = "hook-register";
 	ret = ecnt_register_hook(&xpondrv_hook_dispatch_ops);
