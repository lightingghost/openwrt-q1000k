From: Q1000K development <q1000k@localhost>
Subject: [PATCH] xpon: dispatch checked unicast key exchange and PLOAM writes

--- a/xpon-en757x/xpon_10g/Makefile
+++ b/xpon-en757x/xpon_10g/Makefile
@@ -74,7 +74,7 @@
 
 ifneq ($(TCSUPPORT_CPU_EN7581),)
 ifeq ($(TCSUPPORT_CPU_AN7583),)
-TOTAL_OBJ += $(SRCDIR)/q1000k_identity.o $(SRCDIR)/q1000k_packet.o $(SRCDIR)/q1000k_omci.o $(SRCDIR)/q1000k_transport.o $(SRCDIR)/q1000k_tcont.o $(SRCDIR)/q1000k_gem.o $(SRCDIR)/q1000k_pipeline.o $(SRCDIR)/q1000k_auth.o $(SRCDIR)/q1000k_protocol.o $(SRCDIR)/q1000k_gwan_rebuild.o $(SRCDIR)/q1000k_mac_keys.o $(SRCDIR)/q1000k_mac_cold.o $(SRCDIR)/q1000k_vlan.o $(SRCDIR)/q1000k_services.o $(SRCDIR)/q1000k_omci_backend.o
+TOTAL_OBJ += $(SRCDIR)/q1000k_identity.o $(SRCDIR)/q1000k_packet.o $(SRCDIR)/q1000k_omci.o $(SRCDIR)/q1000k_transport.o $(SRCDIR)/q1000k_tcont.o $(SRCDIR)/q1000k_gem.o $(SRCDIR)/q1000k_pipeline.o $(SRCDIR)/q1000k_auth.o $(SRCDIR)/q1000k_key_exchange.o $(SRCDIR)/q1000k_protocol.o $(SRCDIR)/q1000k_gwan_rebuild.o $(SRCDIR)/q1000k_mac_keys.o $(SRCDIR)/q1000k_mac_cold.o $(SRCDIR)/q1000k_vlan.o $(SRCDIR)/q1000k_services.o $(SRCDIR)/q1000k_omci_backend.o
 endif
 endif
 
--- a/xpon-en757x/xpon_10g/src/gpon/gpon_dev.c
+++ b/xpon-en757x/xpon_10g/src/gpon/gpon_dev.c
@@ -47,6 +47,9 @@
 #include <linux/delay.h>
 #include "common/xpon_global.h"
 #ifdef Q1000K_PON_IDENTITY
+#include "common/q1000k_key_exchange.h"
+#endif
+#ifdef Q1000K_PON_IDENTITY
 #include "common/q1000k_mac_cold.h"
 #include "common/q1000k_protocol.h"
 #endif
@@ -149,6 +152,12 @@
 ******************************************************************************/
 void gponDevSendPloamMsg(PLOAM_RAW_General_T *pPloamMsg)
 {
+#ifdef Q1000K_PON_IDENTITY
+	int ret = q1000k_ploam_send((const u8 *)pPloamMsg);
+
+	if (ret) q1000k_protocol_fail(ret);
+	else gpGponPriv->ploamMsgcounter.txPloamMsgCnt++;
+#else
 	int i=0;
 	
 	for(i=0 ; i< PLOAM_UP_MSG_LENGTH ; i++) {
@@ -160,6 +169,7 @@
 	}
 	
 	gpGponPriv->ploamMsgcounter.txPloamMsgCnt++;
+#endif
 }
 /*****************************************************************************
 ******************************************************************************/
--- a/xpon-en757x/xpon_10g/src/gpon/gpon_ploam.c
+++ b/xpon-en757x/xpon_10g/src/gpon/gpon_ploam.c
@@ -385,9 +385,10 @@
 	case PLOAM_DOWN_MSG_DISABLE_SERIAL_NUM:
 	case PLOAM_DOWN_MSG_REQUEST_REGISTRATION:
 	case PLOAM_DOWN_MSG_ASSIGN_ALLOCID:
+	case PLOAM_DOWN_MSG_KEY_CONTROL:
 		break;
 	default:
-		/* Data-key exchange, remote reboot, private vendor controls,
+		/* Remote reboot, private vendor controls,
 		 * power saving and NG-PON2 need their own checked integrations.
 		 */
 		ret = -EOPNOTSUPP;
@@ -1238,7 +1239,15 @@
 static int ploam_recv_key_control(PLOAM_RAW_Key_Control_T *pKeyControl)
 {
 #ifdef Q1000K_PON_IDENTITY
-	return -EOPNOTSUPP;
+	const u8 *wire = (const u8 *)pKeyControl;
+	u16 dest;
+
+	if (!q1000k_protocol_owned()) return -EPERM;
+	if (!pKeyControl) return -EINVAL;
+	dest = (u16)wire[0] << 8 | wire[1];
+	if (dest != GPON_ONU_ID && dest != PLOAM_BROADCAST_ADDR) return -EINVAL;
+	/* Reserved bits are ignored after whole-message authentication. */
+	return q1000k_omci_key_control(wire[5] & 1, wire[6] & 3, wire[7], wire[3]);
 #else
 	uint msgDestId = 0 ;
 	
