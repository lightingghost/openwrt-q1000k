#include "an7581-q1000k-xgspon-bench.dts"

/ {
	model = "Quantum Fiber Q1000K (XGS-PON RAM activation bench)";
	quantum,xgspon-activation-bench;
};

/* Default controller session remains inhibited. A fresh validation_tx=1
 * session is required for normal protocol activation with private identity. */
&pon_control {
	/delete-property/ quantum,tx-inhibit;
	quantum,activation-bench;
};

/* NAND OEM: LED_PHY_TX_POWER_DISABLE 42 -> GPIO38, active high.
 * Latch high before forcing GPIO, and keep the other PON pins peripheral.
 */
&pon_phy_pins {
	groups = "pon-sw-tx";
};

&en7581_pinctrl {
	pon_board_tx_pins: pon-board-tx-pins {
		level { pins = "gpio38"; output-high; };
		mux { function = "gpio"; groups = "gpio38"; };
	};
};

&pon_control {
	pinctrl-0 = <&pon_control_pins &pon_board_tx_pins>;
	tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
};
