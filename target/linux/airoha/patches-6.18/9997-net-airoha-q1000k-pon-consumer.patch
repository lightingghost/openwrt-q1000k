+++ b/drivers/net/ethernet/airoha/airoha_pon.c
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Q1000K PON transport using the native Ethernet/QDMA owner. */
+#include <linux/of.h>
+#include <linux/rtnetlink.h>
+#include <linux/slab.h>
+#include <linux/soc/airoha/airoha_pon.h>
+#include "airoha_eth.h"
+#include "airoha_regs.h"
+
+struct airoha_pon {
+	struct net_device __rcu *netdev;
+	const struct airoha_pon_ops *ops;
+	void *priv;
+	u64 generation;
+};
+
+static int airoha_pon_tx_msg(const struct airoha_pon_tx_meta *meta, u32 *msg)
+{
+	if (!meta || meta->channel > 31 || meta->queue > 7 ||
+	    meta->cpu_queue >= AIROHA_NUM_TX_RING || meta->mic_index > 1 ||
+	    (!meta->omci && meta->mic_index))
+		return -EINVAL;
+	*msg = FIELD_PREP(QDMA_ETH_TXMSG_CHAN_MASK, meta->channel) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_QUEUE_MASK, meta->queue) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_SP_TAG_MASK, meta->gem) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_OAM_MASK, meta->omci) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_MIC_IDX_MASK, meta->mic_index);
+	return 0;
+}
+
+static int airoha_pon_rx_meta(const u32 words[4], struct airoha_pon_rx_meta *meta)
+{
+	/* Never feed an aggregated or malformed frame to a raw PON consumer. */
+	if ((words[0] & GENMASK(13, 11)) ||
+	    FIELD_GET(QDMA_ETH_RXMSG_AGG_COUNT_MASK, words[2]) > 1)
+		return -EBADMSG;
+	memcpy(meta->words, words, sizeof(meta->words));
+	meta->gem = FIELD_GET(GENMASK(29, 14), words[0]);
+	meta->channel = FIELD_GET(GENMASK(7, 3), words[0]);
+	meta->omci = !!(words[0] & BIT(8));
+	meta->no_mic = !!(words[0] & BIT(30));
+	return 0;
+}
+
+bool airoha_pon_qdma_busy(struct airoha_qdma *qdma)
+{
+	struct airoha_eth *eth = qdma->eth;
+	int i, j;
+
+	ASSERT_RTNL();
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			struct airoha_gdm_dev *dev = port->devs[j];
+
+			if (dev && rcu_access_pointer(dev->qdma) == qdma &&
+			    rcu_access_pointer(dev->pon))
+				return true;
+		}
+	}
+	return false;
+}
+
+static bool airoha_pon_lro_active(struct airoha_qdma *qdma)
+{
+	struct airoha_eth *eth = qdma->eth;
+	int i, j;
+
+	ASSERT_RTNL();
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			struct airoha_gdm_dev *dev = port->devs[j];
+
+			if (dev && rcu_access_pointer(dev->qdma) == qdma &&
+			    (netdev_from_priv(dev)->features &
+			     (NETIF_F_GRO_HW | NETIF_F_LRO)))
+				return true;
+		}
+	}
+	return false;
+}
+
+struct airoha_pon *airoha_pon_attach(struct net_device *netdev,
+				     const struct airoha_pon_ops *ops, void *priv)
+{
+	struct airoha_gdm_dev *dev;
+	struct airoha_pon *pon;
+	int err = -ENODEV;
+
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops || !ops ||
+	    !ops->rx || !ops->tx_wake || !ops->detached)
+		return ERR_PTR(-EINVAL);
+	pon = kzalloc(sizeof(*pon), GFP_KERNEL);
+	if (!pon)
+		return ERR_PTR(-ENOMEM);
+	rtnl_lock();
+	dev = netdev_priv(netdev);
+	if (!dev->pon_port || netdev->reg_state != NETREG_REGISTERED ||
+	    !netif_running(netdev) ||
+	    rcu_access_pointer(dev->qdma) != &dev->eth->qdma[1])
+		goto out;
+	err = -EBUSY;
+	if (rcu_access_pointer(dev->pon) || netdev_has_any_upper_dev(netdev) ||
+	    airoha_pon_lro_active(&dev->eth->qdma[1]))
+		goto out;
+	pon->ops = ops;
+	pon->priv = priv;
+	pon->generation = ++dev->pon_generation;
+	if (!pon->generation)
+		pon->generation = ++dev->pon_generation;
+	rcu_assign_pointer(pon->netdev, netdev);
+	rcu_assign_pointer(dev->pon, pon);
+	rtnl_unlock();
+	return pon;
+out:
+	rtnl_unlock();
+	kfree(pon);
+	return ERR_PTR(err);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_attach);
+
+static void airoha_pon_detach_port(struct airoha_gdm_dev *dev, bool notify)
+{
+	struct airoha_pon *pon;
+
+	ASSERT_RTNL();
+	pon = rcu_dereference_protected(dev->pon, lockdep_rtnl_is_held());
+	if (!pon)
+		return;
+	rcu_assign_pointer(dev->pon, NULL);
+	rcu_assign_pointer(pon->netdev, NULL);
+	/* Drain RX, TX and wake callbacks before notifying or freeing data. */
+	synchronize_net();
+	if (notify)
+		pon->ops->detached(pon->priv);
+}
+
+void airoha_pon_stop(struct airoha_gdm_dev *dev)
+{
+	airoha_pon_detach_port(dev, true);
+}
+
+void airoha_pon_netdev_uninit(struct net_device *netdev)
+{
+	airoha_pon_stop(netdev_priv(netdev));
+}
+
+void airoha_pon_release(struct airoha_pon *pon)
+{
+	struct net_device *netdev;
+
+	if (!pon)
+		return;
+	rtnl_lock();
+	netdev = rcu_dereference_protected(pon->netdev, lockdep_rtnl_is_held());
+	if (netdev)
+		airoha_pon_detach_port(netdev_priv(netdev), false);
+	rtnl_unlock();
+	kfree(pon);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_release);
+
+u64 airoha_pon_generation(struct airoha_gdm_dev *dev)
+{
+	struct airoha_pon *pon;
+	u64 generation;
+
+	rcu_read_lock();
+	pon = rcu_dereference(dev->pon);
+	generation = pon ? pon->generation : 0;
+	rcu_read_unlock();
+	return generation;
+}
+
+void airoha_pon_rx(struct airoha_gdm_dev *dev, struct sk_buff *skb,
+		   const u32 words[4], u64 generation)
+{
+	struct airoha_pon_rx_meta meta;
+	struct airoha_pon *pon;
+
+	rcu_read_lock();
+	pon = rcu_dereference(dev->pon);
+	if (pon && pon->generation == generation &&
+	    !airoha_pon_rx_meta(words, &meta)) {
+		pon->ops->rx(pon->priv, skb, &meta);
+	} else {
+		netdev_from_priv(dev)->stats.rx_dropped++;
+		dev_kfree_skb_any(skb);
+	}
+	rcu_read_unlock();
+}
+
+void airoha_pon_tx_wake(struct airoha_gdm_dev *dev)
+{
+	struct airoha_pon *pon;
+
+	rcu_read_lock();
+	pon = rcu_dereference(dev->pon);
+	if (pon)
+		pon->ops->tx_wake(pon->priv);
+	rcu_read_unlock();
+}
+
+netdev_tx_t airoha_pon_xmit(struct airoha_pon *pon, struct sk_buff *skb,
+			    const struct airoha_pon_tx_meta *meta)
+{
+	struct net_device *netdev, *old_dev;
+	struct netdev_queue *txq;
+	netdev_tx_t ret = NETDEV_TX_OK;
+	u16 old_queue;
+	u32 msg;
+
+	if (!skb)
+		return NETDEV_TX_OK;
+	if (!pon || airoha_pon_tx_msg(meta, &msg) || !skb->len ||
+	    skb->len > AIROHA_MAX_RX_SIZE || !skb_headlen(skb) ||
+	    skb_has_frag_list(skb) || skb_is_gso(skb) ||
+	    skb->ip_summed == CHECKSUM_PARTIAL) {
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+	rcu_read_lock();
+	netdev = rcu_dereference(pon->netdev);
+	if (!netdev || !netif_running(netdev)) {
+		dev_kfree_skb_any(skb);
+		goto out;
+	}
+	txq = netdev_get_tx_queue(netdev, meta->cpu_queue);
+	__netif_tx_lock_bh(txq);
+	if (netif_xmit_stopped(txq)) {
+		ret = NETDEV_TX_BUSY;
+		goto unlock;
+	}
+	old_dev = skb->dev;
+	old_queue = skb_get_queue_mapping(skb);
+	skb->dev = netdev;
+	skb_set_queue_mapping(skb, meta->cpu_queue);
+	ret = airoha_pon_dev_xmit(skb, netdev, msg);
+	if (ret == NETDEV_TX_BUSY) {
+		skb->dev = old_dev;
+		skb_set_queue_mapping(skb, old_queue);
+	}
+unlock:
+	__netif_tx_unlock_bh(txq);
+out:
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_xmit);
