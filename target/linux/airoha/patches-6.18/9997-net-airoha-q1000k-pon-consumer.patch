+++ b/include/linux/soc/airoha/airoha_pon.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_SOC_AIROHA_PON_H
+#define _LINUX_SOC_AIROHA_PON_H
+
+#include <linux/netdevice.h>
+#include <linux/types.h>
+
+struct airoha_pon;
+
+struct airoha_pon_tx_meta {
+	u16 gem;
+	u8 channel;
+	u8 queue;
+	u8 cpu_queue;
+	u8 mic_index;
+	bool omci;
+};
+
+struct airoha_pon_rx_meta {
+	u32 words[4]; /* Host-endian words from the first RX descriptor. */
+	u16 gem;
+	u8 channel;
+	bool omci;
+	bool no_mic; /* Presence only: this is NOT an authentication verdict. */
+};
+
+struct airoha_pon_ops {
+	/* RX owns skb on entry, even when it rejects the frame. skb->data is
+	 * the unparsed frame; no Ethernet header has been pulled. Metadata is
+	 * valid only for this call. RX and tx_wake run under RCU in softirq
+	 * context and must not sleep or call attach/release. tx_wake must not
+	 * submit packets inline (the hardware TX queue lock may be held).
+	 */
+	void (*rx)(void *priv, struct sk_buff *skb,
+		   const struct airoha_pon_rx_meta *meta);
+	void (*tx_wake)(void *priv);
+	/* Lower netdev stopped/removed: called once, under RTNL, after packet
+	 * callbacks drain. Do not acquire RTNL or call this API from here.
+	 * The caller still owns the handle and must eventually release it.
+	 */
+	void (*detached)(void *priv);
+};
+
+/* Attach/release may sleep and acquire RTNL internally. The caller must hold
+ * a reference to netdev during attach. Only an explicitly designated Q1000K
+ * GDM2 PON port that is registered, running and without an upper device may
+ * attach. The caller owns ops/priv until release returns and must stop other
+ * users of the handle before releasing it. No module self-reference is taken.
+ * A generation rejects an old software RX assembly after reattach; it does
+ * not flush descriptors already queued in hardware. The consumer must
+ * coordinate physical ingress and DMA draining before changing sessions.
+ */
+struct airoha_pon *airoha_pon_attach(struct net_device *netdev,
+				     const struct airoha_pon_ops *ops, void *priv);
+void airoha_pon_release(struct airoha_pon *pon);
+
+/* NETDEV_TX_OK consumes skb, including on errors; NETDEV_TX_BUSY leaves it
+ * unchanged and owned by the caller. Only complete, non-GSO frames with
+ * software-computed checksums are supported. MIC generation/verification,
+ * GEM/T-CONT provisioning and physical link state belong to the consumer.
+ * The linear head must be nonempty; nested frag_list skbs are unsupported.
+ * Release drains callbacks, not DMA: accepted packets can still complete
+ * later under the Ethernet owner. It is not an optical TX-quiescence API.
+ */
+netdev_tx_t airoha_pon_xmit(struct airoha_pon *pon, struct sk_buff *skb,
+			    const struct airoha_pon_tx_meta *meta);
+
+#endif
