+
+/* RX admission closes before hardware drain, and opens only after the new
+ * service namespace has been installed by the owning MAC lifecycle.
+ */
+int airoha_pon_drain_rx(struct airoha_pon *pon)
+{
+	struct airoha_eth *eth;
+	unsigned long flags;
+	u32 status, busy;
+	int ret = 0, stable = 0, i;
+
+	if (!pon)
+		return -EINVAL;
+	if (in_interrupt() || irqs_disabled())
+		return -EWOULDBLOCK;
+	rtnl_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	if (!rcu_access_pointer(pon->netdev))
+		ret = -ENODEV;
+	else if (pon->control_fault)
+		ret = -EIO;
+	else if (pon->configuring || !pon->paused || !pon->pause_ready ||
+		 pon->fe_retired != U32_MAX || atomic_read_acquire(&pon->pending))
+		ret = -EBUSY;
+	else if (pon->rx_drained)
+		ret = 1;
+	if (ret) {
+		spin_unlock_irqrestore(&pon->admission_lock, flags);
+		if (ret == 1)
+			ret = 0;
+		goto out;
+	}
+	pon->configuring = U32_MAX;
+	WRITE_ONCE(pon->rx_closed, true);
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	/* Complete callbacks admitted before rx_closed was published. */
+	synchronize_net();
+	eth = pon->dma_dev->eth;
+	if (airoha_pon_qdma_shared(pon->dma_dev) ||
+	    airoha_fe_rr(eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX)) ||
+	    airoha_fe_rr(eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX)) ||
+	    airoha_fe_rr(eth, REG_CDM_HWFWD_CHN(AIROHA_GDM2_IDX))) {
+		ret = -EIO;
+		goto complete;
+	}
+	/* OEM retire-all checks the whole-port word at GDM2 + 0x74 after
+	 * individual releases. Require two stable zero observations and retain
+	 * errors, unlike the OEM diagnostic-only timeout path.
+	 */
+	ret = -ETIMEDOUT;
+	for (i = 0; i < 50; i++) {
+		status = airoha_fe_rr(eth, REG_GDM_RETIRE_STS(AIROHA_GDM2_IDX));
+		busy = airoha_fe_rr(eth, REG_GDM_CHN_BUSY(AIROHA_GDM2_IDX));
+		if (status == U32_MAX || busy == U32_MAX) {
+			ret = -EIO;
+			break;
+		}
+		if (!status && !busy) {
+			if (++stable == 2) {
+				ret = 0;
+				break;
+			}
+		} else {
+			stable = 0;
+		}
+		usleep_range(1000, 1500);
+	}
+	if (!ret)
+		ret = airoha_qdma_pon_drain_rx(&eth->qdma[1]);
+complete:
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	if (ret)
+		pon->control_fault = true;
+	else
+		pon->rx_drained = true;
+	pon->configuring = 0;
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+out:
+	rtnl_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_drain_rx);
 
