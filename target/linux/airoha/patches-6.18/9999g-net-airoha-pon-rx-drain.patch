+
+/* Stop only the exclusively owned QDMA1 receive engine. TX and QDMA0 stay
+ * under their existing owner. The caller has closed GDM2 ingress and proved
+ * FE retirement; this function establishes the DMA/descriptor boundary.
+ */
+static int airoha_qdma_pon_rx_irq(struct airoha_qdma *qdma, bool enable)
+{
+	int bank, index, first = 0;
+
+	for (bank = 0; bank < ARRAY_SIZE(qdma->irq_banks); bank++) {
+		struct airoha_irq_bank *irq_bank = &qdma->irq_banks[bank];
+		unsigned long flags;
+
+		for (index = QDMA_INT_REG_IDX1; index <= QDMA_INT_REG_IDX2; index++) {
+			u32 mask = index == QDMA_INT_REG_IDX1 ?
+				INT_RX1_MASK(RX_IRQ_BANK_PIN_MASK(bank)) :
+				INT_RX2_MASK(RX_IRQ_BANK_PIN_MASK(bank));
+			u32 actual;
+
+			spin_lock_irqsave(&irq_bank->irq_lock, flags);
+			if (enable)
+				irq_bank->irqmask[index] |= mask;
+			else
+				irq_bank->irqmask[index] &= ~mask;
+			airoha_qdma_wr(qdma, REG_INT_ENABLE(bank, index),
+				       irq_bank->irqmask[index]);
+			actual = airoha_qdma_rr(qdma, REG_INT_ENABLE(bank, index));
+			if (actual != irq_bank->irqmask[index])
+				first = -EIO;
+			spin_unlock_irqrestore(&irq_bank->irq_lock, flags);
+		}
+	}
+	return first;
+}
+
+static int airoha_qdma_pon_discard_rx(struct airoha_queue *q)
+{
+	if (!q->ndesc)
+		return 0;
+	if (q->skb) {
+		dev_kfree_skb_any(q->skb);
+		q->skb = NULL;
+	}
+	q->pon_drain = true;
+	/* At most one ring of completed descriptors; the engine cannot refill.
+	 * MORE chains are discarded too, without delivering a partial packet.
+	 */
+	airoha_qdma_rx_process(q, q->ndesc);
+	q->pon_drain = false;
+	q->rx_discard = false;
+	q->pon_frame = false;
+	q->pon_generation = 0;
+	if (le32_to_cpu(READ_ONCE(q->desc[q->tail].ctrl)) & QDMA_DESC_DONE_MASK)
+		return -EIO;
+	return 0;
+}
+
+int airoha_qdma_pon_drain_rx(struct airoha_qdma *qdma)
+{
+	u32 value;
+	int i, ret, restore;
+
+	ASSERT_RTNL();
+	if (qdma != &qdma->eth->qdma[1] || qdma->users != 1)
+		return -EBUSY;
+	value = airoha_qdma_rr(qdma, REG_QDMA_GLOBAL_CFG);
+	if (value == U32_MAX || !(value & GLOBAL_CFG_RX_DMA_EN_MASK))
+		return -EIO;
+	airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG, GLOBAL_CFG_RX_DMA_EN_MASK);
+	ret = read_poll_timeout(airoha_qdma_rr, value,
+			       value == U32_MAX || !(value & GLOBAL_CFG_RX_DMA_BUSY_MASK),
+			       1000, 50000, true, qdma, REG_QDMA_GLOBAL_CFG);
+	if (value == U32_MAX || (value & GLOBAL_CFG_RX_DMA_EN_MASK))
+		return -EIO;
+	if (ret)
+		return ret; /* No descriptor or page may be touched while DMA is busy. */
+	ret = airoha_qdma_pon_rx_irq(qdma, false);
+	for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++)
+		synchronize_irq(qdma->irq_banks[i].irq);
+	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++)
+		if (qdma->q_rx[i].ndesc)
+			napi_disable(&qdma->q_rx[i].napi);
+	/* A NAPI completion may have re-enabled its source before disable won. */
+	restore = airoha_qdma_pon_rx_irq(qdma, false);
+	if (!ret)
+		ret = restore;
+	for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++)
+		synchronize_irq(qdma->irq_banks[i].irq);
+	if (!ret)
+		for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++) {
+			restore = airoha_qdma_pon_discard_rx(&qdma->q_rx[i]);
+			if (restore && !ret)
+				ret = restore;
+		}
+	/* Keep normal NAPI lifetime balanced, even on failure. RX DMA remains
+	 * off until the owning PON lifecycle explicitly activates a new epoch.
+	 */
+	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++)
+		if (qdma->q_rx[i].ndesc)
+			napi_enable(&qdma->q_rx[i].napi);
+	restore = airoha_qdma_pon_rx_irq(qdma, true);
+	return ret ? ret : restore;
 }
 
