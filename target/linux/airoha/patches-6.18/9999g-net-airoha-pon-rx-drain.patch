+/* Drain downstream FE/QDMA1 RX after all 32 channels were retired, with the
+ * MAC ingress already stopped by its owner. Requires a completed CPU pause.
+ * Close RX callbacks, check whole-port retirement, stop RX DMA and wait for
+ * idle before draining NAPI/descriptors. Success keeps RX admission and DMA
+ * closed; service identifiers must not be reused until this succeeds.
+ * Failure is sticky and never frees pages while DMA is still busy.
+ */
+int airoha_pon_drain_rx(struct airoha_pon *pon);
+
 /* Pause CPU admission without disconnecting RX/consumer callbacks. Invalidate
  * every old TX lease, wait up to timeout_ms (0..3000) for native mappings,
  * then close all physical queues. Retrying a timed-out pause is supported;
