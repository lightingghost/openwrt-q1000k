+/* GDM2 frame limits and QDMA1-wide scheduler weight units. Actual changes
+ * require a fully retired, drained port. Reads are allowed while running.
+ * configure uses an expected snapshot and returns ESTALE if it has changed.
+ * All unrelated register fields and the other QDMA instance are preserved.
+ */
+struct airoha_pon_port_config {
+	u16 min_len, max_len;
+	bool byte_mode, scale16;
+};
