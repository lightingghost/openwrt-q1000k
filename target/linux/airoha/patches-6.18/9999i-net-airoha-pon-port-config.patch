 	if (ret)
 		return ret;
-	if ((status & (TWRR_CHAN_IDX_MASK | TWRR_QUEUE_IDX_MASK)) !=
+	if (status == U32_MAX ||
+	    (status & (TWRR_CHAN_IDX_MASK | TWRR_QUEUE_IDX_MASK)) !=
 	    (cmd & (TWRR_CHAN_IDX_MASK | TWRR_QUEUE_IDX_MASK)))
 		return -EIO;
 	if (!write)
@@ -506,6 +507,10 @@
 	spin_unlock_irqrestore(&pon->admission_lock, flags);
 	qdma = &pon->dma_dev->eth->qdma[1];
 	mode = airoha_qdma_rr(qdma, REG_TXWRR_MODE_CFG);
