+/* Permanently close one channel for this attachment and poll native TX
+ * descriptor reclamation. IRQ-safe and nonblocking; -EAGAIN means mappings
+ * remain, zero means all native mappings for this channel were reclaimed.
+ * Repeated calls are safe. Queue reopening returns -ESHUTDOWN after this
+ * operation, even once drained. Other channels and callbacks remain active.
+ * The caller must retain the handle. Disconnect returns -ENODEV; queue
+ * readback failure returns -EIO, never a successful drain result.
+ * This is not FE/optical FIFO retirement or an RX/PHY/reset operation. A new
+ * attachment must not be used to bypass the missing physical retirement.
+ */
+int airoha_pon_quiesce_channel(struct airoha_pon *pon, u8 channel);
+
 /* Queue configuration requires exclusive QDMA1 ownership: attach rejects
  * every other assigned netdev (even down) and QoS allocation, then closes all
  * 32 x 8 TX queues. set/get/prepare are IRQ-safe and serialized against TX.
