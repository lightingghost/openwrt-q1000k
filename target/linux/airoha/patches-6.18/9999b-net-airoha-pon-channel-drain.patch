+}
+
+int airoha_pon_set_queue_close(struct airoha_pon *pon, u8 channel, u8 closed)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!pon || channel >= ARRAY_SIZE(pon->closed))
+		return -EINVAL;
+	rcu_read_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	ret = airoha_pon_set_queue_close_locked(pon, channel, closed);
 	spin_unlock_irqrestore(&pon->admission_lock, flags);
 	rcu_read_unlock();
 	return ret;
 }
 EXPORT_SYMBOL_GPL(airoha_pon_set_queue_close);
+
+int airoha_pon_quiesce_channel(struct airoha_pon *pon, u8 channel)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!pon || channel >= ARRAY_SIZE(pon->closed))
+		return -EINVAL;
+	rcu_read_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	/* Permanent for this attachment, including after a closure error.
+	 * No later queue control can reopen it behind the retirement caller.
+	 */
+	pon->retiring |= BIT(channel);
+	ret = airoha_pon_set_queue_close_locked(pon, channel, 0xff);
+	if (!ret && atomic_read_acquire(&pon->channel_pending[channel]))
+		ret = -EAGAIN;
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_quiesce_channel);
 
