+static int airoha_pon_set_queue_close_locked(struct airoha_pon *pon,
+					    u8 channel, u8 closed)
+{
 	struct airoha_qdma *qdma;
-	unsigned long flags;
 	u32 mask, value;
 	int ret = 0;
 
