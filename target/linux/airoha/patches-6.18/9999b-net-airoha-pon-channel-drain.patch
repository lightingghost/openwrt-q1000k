+void airoha_pon_tx_complete(struct airoha_pon *pon, u8 channel)
 {
 	if (!pon)
 		return;
+	/* Publish native unmapping before a channel can report drained. */
+	atomic_dec_return_release(&pon->channel_pending[channel]);
 	atomic_dec(&pon->dma_dev->pon_tx_pending);
 	if (atomic_dec_and_test(&pon->pending))
 		wake_up_all(&pon->drained);
@@ -171,8 +176,10 @@
 		}
