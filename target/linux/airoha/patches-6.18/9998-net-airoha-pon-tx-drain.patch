--- a/drivers/net/ethernet/airoha/airoha_pon.c
+++ b/drivers/net/ethernet/airoha/airoha_pon.c
@@ -1,6 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* Q1000K PON transport using the native Ethernet/QDMA owner. */
 #include <linux/of.h>
+#include <linux/refcount.h>
+#include <linux/wait.h>
 #include <linux/rtnetlink.h>
 #include <linux/slab.h>
 #include <linux/soc/airoha/airoha_pon.h>
@@ -12,7 +14,39 @@
 	const struct airoha_pon_ops *ops;
 	void *priv;
 	u64 generation;
+	/* Native DMA owns the lower storage until its descriptors are reaped. */
+	struct airoha_gdm_dev *dma_dev;
+	refcount_t refs;
+	atomic_t pending;
+	wait_queue_head_t drained;
 };
+
+static void airoha_pon_put(struct airoha_pon *pon)
+{
+	if (refcount_dec_and_test(&pon->refs))
+		kfree(pon);
+}
+
+/* One reference per mapped descriptor, acquired before publication. */
+void airoha_pon_tx_get(struct airoha_pon *pon)
+{
+	if (!pon)
+		return;
+	refcount_inc(&pon->refs);
+	atomic_inc(&pon->pending);
+	atomic_inc(&pon->dma_dev->pon_tx_pending);
+}
+
+/* No consumer callbacks or private data may be accessed here. */
+void airoha_pon_tx_complete(struct airoha_pon *pon)
+{
+	if (!pon)
+		return;
+	atomic_dec(&pon->dma_dev->pon_tx_pending);
+	if (atomic_dec_and_test(&pon->pending))
+		wake_up_all(&pon->drained);
+	airoha_pon_put(pon);
+}
 
 static int airoha_pon_tx_msg(const struct airoha_pon_tx_meta *meta, u32 *msg)
 {
@@ -57,7 +91,8 @@
 			struct airoha_gdm_dev *dev = port->devs[j];
 
 			if (dev && rcu_access_pointer(dev->qdma) == qdma &&
-			    rcu_access_pointer(dev->pon))
+			    (rcu_access_pointer(dev->pon) ||
+			     atomic_read(&dev->pon_tx_pending)))
 				return true;
 		}
 	}
@@ -107,9 +142,14 @@
 	    rcu_access_pointer(dev->qdma) != &dev->eth->qdma[1])
 		goto out;
 	err = -EBUSY;
-	if (rcu_access_pointer(dev->pon) || netdev_has_any_upper_dev(netdev) ||
+	if (rcu_access_pointer(dev->pon) || atomic_read(&dev->pon_tx_pending) ||
+	    netdev_has_any_upper_dev(netdev) ||
 	    airoha_pon_lro_active(&dev->eth->qdma[1]))
 		goto out;
+	refcount_set(&pon->refs, 1);
+	atomic_set(&pon->pending, 0);
+	init_waitqueue_head(&pon->drained);
+	pon->dma_dev = dev;
 	pon->ops = ops;
 	pon->priv = priv;
 	pon->generation = ++dev->pon_generation;
@@ -152,18 +192,37 @@
 	airoha_pon_stop(netdev_priv(netdev));
 }
 
-void airoha_pon_release(struct airoha_pon *pon)
+static void airoha_pon_disconnect(struct airoha_pon *pon)
 {
 	struct net_device *netdev;
 
-	if (!pon)
-		return;
 	rtnl_lock();
 	netdev = rcu_dereference_protected(pon->netdev, lockdep_rtnl_is_held());
 	if (netdev)
 		airoha_pon_detach_port(netdev_priv(netdev), false);
 	rtnl_unlock();
-	kfree(pon);
+}
+
+int airoha_pon_quiesce(struct airoha_pon *pon, unsigned int timeout_ms)
+{
+	if (!pon)
+		return -EINVAL;
+	/* Do not wait for DMA under RTNL: lower stop may need it to reap TX. */
+	airoha_pon_disconnect(pon);
+	if (!wait_event_timeout(pon->drained, !atomic_read(&pon->pending),
+				msecs_to_jiffies(timeout_ms)))
+		return -ETIMEDOUT;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_quiesce);
+
+void airoha_pon_release(struct airoha_pon *pon)
+{
+	if (!pon)
+		return;
+	airoha_pon_disconnect(pon);
+	/* Descriptors retain only internal storage, never ops or priv. */
+	airoha_pon_put(pon);
 }
 EXPORT_SYMBOL_GPL(airoha_pon_release);
 
@@ -242,7 +301,7 @@
 	old_queue = skb_get_queue_mapping(skb);
 	skb->dev = netdev;
 	skb_set_queue_mapping(skb, meta->cpu_queue);
-	ret = airoha_pon_dev_xmit(skb, netdev, msg);
+	ret = airoha_pon_dev_xmit(skb, netdev, msg, pon);
 	if (ret == NETDEV_TX_BUSY) {
 		skb->dev = old_dev;
 		skb_set_queue_mapping(skb, old_queue);
--- a/include/linux/soc/airoha/airoha_pon.h
+++ b/include/linux/soc/airoha/airoha_pon.h
@@ -54,13 +54,26 @@
 				     const struct airoha_pon_ops *ops, void *priv);
 void airoha_pon_release(struct airoha_pon *pon);
 
+/* Permanently disconnect callbacks/TX submission and wait up to timeout_ms
+ * for this attachment's mapped TX descriptors to be reaped by the native
+ * owner. May sleep; do not hold RTNL or call from a callback. Zero timeout
+ * polls. -ETIMEDOUT leaves the attachment disconnected; retry or release is
+ * safe. The caller must retain its handle throughout this call.
+ * This does not stop shared DMA, flush RX, or prove that FE/optical FIFOs are
+ * empty. The consumer must separately gate the MAC/PHY before power/reset.
+ * A new attachment is rejected while an earlier one's descriptors remain.
+ */
+int airoha_pon_quiesce(struct airoha_pon *pon, unsigned int timeout_ms);
+
 /* NETDEV_TX_OK consumes skb, including on errors; NETDEV_TX_BUSY leaves it
  * unchanged and owned by the caller. Only complete, non-GSO frames with
  * software-computed checksums are supported. MIC generation/verification,
  * GEM/T-CONT provisioning and physical link state belong to the consumer.
  * The linear head must be nonempty; nested frag_list skbs are unsupported.
  * Release drains callbacks, not DMA: accepted packets can still complete
- * later under the Ethernet owner. It is not an optical TX-quiescence API.
+ * later under the Ethernet owner. Internal handle storage remains owned by
+ * those descriptors without retaining consumer ops/priv. Use quiesce to
+ * wait for TX descriptor reclamation, not for optical FIFO emptiness.
  */
 netdev_tx_t airoha_pon_xmit(struct airoha_pon *pon, struct sk_buff *skb,
 			    const struct airoha_pon_tx_meta *meta);
