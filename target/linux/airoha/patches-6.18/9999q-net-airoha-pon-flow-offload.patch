+/* An unacknowledged PPE write may have reached hardware. Keep this fault
+ * for the lower device's lifetime, across consumer detach/reattach. Only a
+ * new native FE instance may reopen the namespace after such a failure.
+ */
+static void airoha_ppe_pon_fault(struct airoha_gdm_dev *dev)
+{
+	WRITE_ONCE(dev->pon_flow_fault, true);
+	airoha_fe_wr(dev->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), 0);
+	airoha_fe_rr(dev->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX));
+}
