+/* Factory AN7581 PpeSetPortInfo uses l2.etype as the PON special tag:
+ * GEM at byte 46 (IPv4) / 50 (IPv6); channel/QID at word 10; NBQ in IB2.
+ * Keep fast-path clear: upstream uses the QDMA1 service scheduler.
+ */
+static void airoha_ppe_foe_set_pon(struct airoha_foe_entry *hwe,
+				 const struct airoha_pon_flow *flow, bool ipv6)
+{
+	struct airoha_foe_mac_info_common *l2 = ipv6 ? &hwe->ipv6.l2 :
+						     &hwe->ipv4.l2.common;
+	u32 *ib2 = ipv6 ? &hwe->ipv6.ib2 : &hwe->ipv4.ib2;
+	u32 *qdata = ipv6 ? &hwe->ipv6.data : &hwe->ipv4.data;
+
+	*ib2 &= ~(AIROHA_FOE_IB2_PSE_PORT | AIROHA_FOE_IB2_NBQ |
+		  AIROHA_FOE_IB2_FAST_PATH);
+	*ib2 |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, AIROHA_GDM2_IDX) |
+		FIELD_PREP(AIROHA_FOE_IB2_NBQ, flow->channel) |
+		AIROHA_FOE_IB2_PSE_QOS;
+	*qdata &= ~(AIROHA_FOE_CHANNEL | AIROHA_FOE_QID);
+	*qdata |= FIELD_PREP(AIROHA_FOE_CHANNEL, flow->channel) |
+		  FIELD_PREP(AIROHA_FOE_QID, flow->queue);
+	l2->etype = flow->gem;
+	if (ipv6) {
+		l2->src_mac_hi &= ~AIROHA_FOE_MAC_SMAC_ID;
+		l2->src_mac_hi |= FIELD_PREP(AIROHA_FOE_MAC_SMAC_ID, AIROHA_GDM2_IDX);
+	}
+}
