+static void airoha_pon_invalidate_flows_locked(struct airoha_pon *pon)
+{
+	lockdep_assert_held(&pon->admission_lock);
+	if (airoha_ppe_pon_invalidate(pon->dma_dev)) {
+		pon->control_fault = true;
+		airoha_fe_wr(pon->dma_dev->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), 0);
+		/* Flush the containment write. Never clear this fault on resume. */
+		airoha_fe_rr(pon->dma_dev->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX));
+	}
+}
+
+void airoha_pon_invalidate_flows(struct airoha_pon *pon)
+{
+	unsigned long flags;
+
+	if (!pon)
+		return;
+	rcu_read_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	if (rcu_access_pointer(pon->netdev))
+		airoha_pon_invalidate_flows_locked(pon);
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(airoha_pon_invalidate_flows);
+
+int airoha_pon_resolve_flow(struct airoha_eth *eth, struct net_device *upper,
+			  u16 ethertype, const u8 *smac,
+			  struct airoha_pon_flow *flow,
+			  struct airoha_gdm_dev **owner)
+{
+	struct airoha_gdm_port *port = eth->ports[AIROHA_GDM2_IDX - 1];
+	unsigned long flags;
+	int i, ret = -ENOENT;
+
+	/* GDM2's designated PON endpoint is the only candidate. Native port
+	 * indices are not netdev private layouts: never cast the upper here.
+	 */
+	if (!upper || !port)
+		return ret;
+	rcu_read_lock();
+	for (i = 0; i < ARRAY_SIZE(port->devs); i++) {
+		struct airoha_gdm_dev *dev = port->devs[i];
+		struct airoha_pon *pon;
+
+		if (!dev || !dev->pon_port)
+			continue;
+		pon = rcu_dereference(dev->pon);
+		if (!pon || !pon->ops->flow)
+			continue;
+		spin_lock_irqsave(&pon->admission_lock, flags);
+		ret = rcu_access_pointer(pon->netdev) == netdev_from_priv(dev) ?
+			pon->ops->flow(pon->priv, upper, ethertype, flow) : -ENODEV;
+		if (!ret && (pon->paused || pon->control_fault || READ_ONCE(dev->pon_flow_fault) || pon->rx_closed ||
+		    flow->channel == 0 || flow->channel >= 32 || flow->queue >= 8 ||
+		    !flow->gem || flow->num_vlans > 2 ||
+		    !(pon->tx_enabled & BIT(flow->channel)) ||
+		    (pon->retiring & BIT(flow->channel)) ||
+		    (pon->configuring & BIT(flow->channel)) ||
+		    (pon->closed[flow->channel] & BIT(flow->queue))))
+			ret = -ESHUTDOWN;
+		if (!ret && !ether_addr_equal(smac, upper->dev_addr))
+			ret = -EOPNOTSUPP;
+		if (!ret && !ether_addr_equal(dev->pon_smac, smac)) {
+			airoha_pon_invalidate_flows_locked(pon);
+			if (pon->control_fault || READ_ONCE(pon->dma_dev->pon_flow_fault))
+				ret = -EIO;
+			else {
+				airoha_ppe_init_upd_mem(dev, smac);
+				ether_addr_copy(dev->pon_smac, smac);
+			}
+		}
+		if (!ret) {
+			flow->epoch = dev->pon_flow_epoch;
+			*owner = dev;
+		}
+		spin_unlock_irqrestore(&pon->admission_lock, flags);
+		if (ret != -ENOENT)
+			break;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+static void airoha_pon_fault_locked(struct airoha_pon *pon)
+{
+	pon->control_fault = true;
+	airoha_pon_invalidate_flows_locked(pon);
+}
