+void airoha_ppe_release_flow_block(struct airoha_eth *eth, const void *owner)
+{
+	struct airoha_flow_table_entry *e, *tmp;
+	struct rhashtable_iter iter;
+	LIST_HEAD(retired);
+
+	if (!owner || !eth->ppe)
+		return;
+	/* The callback is about to disappear. Retire its hardware entries
+	 * synchronously even if no later per-cookie DESTROY can reach us.
+	 * Other flowtables (and WLAN callbacks with no owner) stay intact.
+	 */
+	mutex_lock(&flow_offload_mutex);
+	rhashtable_walk_enter(&eth->flow_table, &iter);
+	rhashtable_walk_start(&iter);
+	while ((e = rhashtable_walk_next(&iter))) {
+		if (IS_ERR(e)) {
+			if (PTR_ERR(e) == -EAGAIN)
+				continue;
+			break;
+		}
+		if (e->block_owner != owner)
+			continue;
+		airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+		rhashtable_remove_fast(&eth->flow_table, &e->node,
+				       airoha_flow_table_params);
+		/* The iterator still holds the current hash node until next(). */
+		list_add_tail(&e->pon_list, &retired);
+	}
+	rhashtable_walk_stop(&iter);
+	rhashtable_walk_exit(&iter);
+	list_for_each_entry_safe(e, tmp, &retired, pon_list) {
+		list_del(&e->pon_list);
+		kfree(e);
+	}
+	mutex_unlock(&flow_offload_mutex);
+}
