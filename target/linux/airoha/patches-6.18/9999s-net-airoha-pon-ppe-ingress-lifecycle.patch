--- a/drivers/net/ethernet/airoha/airoha_pon_ifc.h
+++ b/drivers/net/ethernet/airoha/airoha_pon_ifc.h
@@ -14,6 +14,9 @@
 #define PON_IFC_RULE_END		BIT(30)
 #define PON_IFC_FORCE_PORT	BIT(28)
 #define PON_IFC_ROWS		64
+#define PON_IFC_FALLBACK_ROW	(PON_IFC_ROWS - 1)
+#define PON_IFC_RX_HIT		BIT(7)
+#define PON_IFC_RX_ROW		GENMASK(16, 8)
 
 /* Type zero: Ethernet/GEM key, nine words in reverse hardware word order.
  * VPM=1 denotes 802.1Q; VLAN0/1 validity distinguishes an untagged frame
@@ -146,15 +149,63 @@
 				     enable ? bit : 0);
 }
 
+static int airoha_pon_ifc_route(struct airoha_eth *eth, bool enable)
+{
+	u32 port = enable ? FE_PSE_PORT_PPE1 : FE_PSE_PORT_CDM2;
+
+	/* Factory SetGdmaFwd enters PPE at GDM2. IFC selects exceptions on
+	 * that path; a CPU default must not be used to establish PPE ingress.
+	 * Preserve checksum, CRC and padding configuration above bit 15.
+	 */
+	return airoha_pon_ifc_register(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX),
+				     GENMASK(15, 0), port * 0x1111);
+}
+
+static int airoha_pon_ifc_rule(struct airoha_eth *eth, unsigned int row,
+			     const u32 key[9], const u32 mask[9])
+{
+	unsigned int i;
+	int err;
+
+	for (i = 0; i < 9; i++) {
+		u32 data[2] = { key[i], mask[i] };
+
+		err = airoha_pon_ifc_word(eth, row, 8 - i, false, data, 2);
+		if (err)
+			return err;
+	}
+	return 0;
+}
+
+static int airoha_pon_ifc_fallback(struct airoha_eth *eth)
+{
+	u32 key[9] = {}, mask[9] = {}, action[6] = {};
+	int err;
+
+	/* The final rule catches all GDM2 frames outside the admitted rows.
+	 * Match only the source-interface bit, not unrelated SINF bits.
+	 * Other FE ingress ports retain their own forwarding destinations.
+	 */
+	mask[0] = GENMASK(7, 6);
+	key[8] = mask[8] = BIT(AIROHA_GDM2_IDX);
+	action[0] = PON_IFC_RULE_ENABLE | PON_IFC_RULE_END;
+	action[2] = PON_IFC_FORCE_PORT;
+	action[5] = FE_PSE_PORT_CDM2 << 8;
+	err = airoha_pon_ifc_rule(eth, PON_IFC_FALLBACK_ROW, key, mask);
+	return err ?: airoha_pon_ifc_action(eth, PON_IFC_FALLBACK_ROW, action);
+}
+
 static int airoha_ppe_pon_ifc_close(struct airoha_gdm_dev *dev)
 {
-	int ret;
+	int ret, gate;
 
 	lockdep_assert_held(&ppe_lock);
-	ret = airoha_pon_ifc_port(dev->eth, false);
+	/* Stop entering PPE before disconnecting its namespace classifier. */
+	ret = airoha_pon_ifc_route(dev->eth, false);
+	gate = airoha_pon_ifc_port(dev->eth, false);
 	dev->pon_ingress[0].valid = false;
 	dev->pon_ingress[1].valid = false;
-	return ret;
+	return ret ?: gate;
 }
 
