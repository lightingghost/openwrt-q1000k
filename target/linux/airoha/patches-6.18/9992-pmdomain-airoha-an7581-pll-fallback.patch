 static int airoha_cpu_pmdomain_clk_is_enabled(struct clk_hw *hw)
 {
 	return true;
@@ -51,17 +124,135 @@
 	.determine_rate = airoha_cpu_pmdomain_clk_determine_rate,
 };
 
-static int airoha_cpu_pmdomain_set_performance_state(struct generic_pm_domain *domain,
-						     unsigned int state)
+/* Set CPU frequency via SMC */
+static int airoha_cpu_smc_set_freq(unsigned int state)
 {
 	struct arm_smccc_res res;
 
 	arm_smccc_1_1_invoke(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_FREQ_DYN_ADJ,
 			     0, state, 0, 0, 0, 0, &res);
 
-	/* SMC signal correct apply by unsetting BIT 0 */
 	return res.a0 & BIT(0) ? -EINVAL : 0;
 }
+
+struct airoha_cpu_pll_change {
+	struct airoha_cpu_pmdomain_priv *priv;
+	u32 pcw;
+	u32 posdiv;
+};
+
+/*
+ * All CPUs use this PLL. Keep them quiescent for the clock-source switch.
+ * The chip-SCU is a shared MMIO syscon: use its existing, non-sleeping regmap.
+ * The temporary 400 MHz PLL2 source and 20 us settling delay follow the
+ * community AN7581 fallback/ATF sequence.
+ */
+static int airoha_cpu_pll_change_stopped(void *data)
+{
+	struct airoha_cpu_pll_change *change = data;
+	struct airoha_cpu_pmdomain_priv *priv = change->priv;
+	struct regmap *map = priv->pll_map;
+	void __iomem *mcu = priv->mcucfg;
+	u32 mux, protect, pcw, chg, unlock, source, new_pcw, new_chg, check, target;
+	unsigned long flags;
+	int ret;
+
+	raw_spin_lock_irqsave(&priv->rate_lock, flags);
+	ret = regmap_read(map, CPUPLL_CLK_MUX, &mux);
+	ret |= regmap_read(map, PLLRG_PROTECT, &protect);
+	ret |= regmap_read(map, CPUPLL_SDM_PCW, &pcw);
+	ret |= regmap_read(map, CPUPLL_SDM_PCW_CHG, &chg);
+	if (ret)
+		goto out;
+	unlock = readl(mcu + MCUCFG_CK_SWITCH_UNLOCK);
+	source = readl(mcu + MCUCFG_CK_SOURCE_SEL);
+	new_pcw = (pcw & ~CPUPLL_PCW_MASK) |
+		  FIELD_PREP(CPUPLL_PCW_INT_MASK, change->pcw);
+	new_chg = (chg & ~(CPUPLL_CHG_POSDIV_MASK | CPUPLL_CHG_BIT)) |
+		  FIELD_PREP(CPUPLL_CHG_POSDIV_MASK, change->posdiv) |
+		  ((chg ^ CPUPLL_CHG_BIT) & CPUPLL_CHG_BIT);
+
+	ret = regmap_write(map, CPUPLL_CLK_MUX, mux | BIT(MCUCFG_CK_SEL_PLL2 - 1));
+	if (ret)
+		goto out;
+	writel((unlock & ~0x1f) | MCUCFG_CK_UNLOCK_KEY, mcu + MCUCFG_CK_SWITCH_UNLOCK);
+	writel((source & ~MCUCFG_CK_SEL_MASK) |
+	       FIELD_PREP(MCUCFG_CK_SEL_MASK, MCUCFG_CK_SEL_PLL2), mcu + MCUCFG_CK_SOURCE_SEL);
+	/* Verify the backup source before touching the active PLL. */
+	if (FIELD_GET(MCUCFG_CK_SEL_MASK, readl(mcu + MCUCFG_CK_SOURCE_SEL)) !=
+	    MCUCFG_CK_SEL_PLL2) {
+		regmap_write(map, CPUPLL_CLK_MUX, mux);
+		writel(unlock, mcu + MCUCFG_CK_SWITCH_UNLOCK);
+		ret = -EIO;
+		goto out;
+	}
+
+	ret = regmap_write(map, PLLRG_PROTECT,
+			   (protect & ~PLLRG_PROTECT_MASK) | PLLRG_PROTECT_KEY);
+	if (!ret)
+		ret = regmap_write(map, CPUPLL_SDM_PCW, new_pcw);
+	if (!ret)
+		ret = regmap_write(map, CPUPLL_SDM_PCW_CHG, new_chg);
+	if (!ret)
+		ret = regmap_read(map, CPUPLL_SDM_PCW_CHG, &check);
+	if (!ret && check != new_chg)
+		ret = -EIO;
+	if (!ret)
+		ret = regmap_read(map, CPUPLL_SDM_PCW, &check);
+	if (!ret && check != new_pcw)
+		ret = -EIO;
+	if (ret) {
+		/* Restore the old PLL before returning to the original source. */
+		regmap_write(map, CPUPLL_SDM_PCW, pcw);
+		regmap_write(map, CPUPLL_SDM_PCW_CHG, chg);
+	}
+	udelay(20);
+	/* Keep PLL2 enabled until the CPU has switched away from it. */
+	regmap_write(map, CPUPLL_CLK_MUX,
+		     mux | BIT(MCUCFG_CK_SEL_ARMPLL - 1) | BIT(MCUCFG_CK_SEL_PLL2 - 1));
+	target = ret ? source : (source & ~MCUCFG_CK_SEL_MASK) |
+		 FIELD_PREP(MCUCFG_CK_SEL_MASK, MCUCFG_CK_SEL_ARMPLL);
+	writel(target, mcu + MCUCFG_CK_SOURCE_SEL);
+	if (readl(mcu + MCUCFG_CK_SOURCE_SEL) == target)
+		regmap_write(map, CPUPLL_CLK_MUX, ret ? mux : mux | BIT(MCUCFG_CK_SEL_ARMPLL - 1));
+	else
+		ret = -EIO; /* Leave both paths enabled if switching back failed. */
+	regmap_write(map, PLLRG_PROTECT, protect);
+	writel(unlock, mcu + MCUCFG_CK_SWITCH_UNLOCK);
+out:
+	raw_spin_unlock_irqrestore(&priv->rate_lock, flags);
+	return ret;
+}
+
+static int airoha_cpu_pll_set_freq(struct airoha_cpu_pmdomain_priv *priv,
+				   unsigned int state)
+{
+	struct airoha_cpu_pll_change change = { .priv = priv };
+	unsigned int mhz;
+
+	/* Preserve Q1000K's stock 500..1200 MHz OPPs. No voltage/OC changes. */
+	if (state > AN7581_MAX_PERF_STATE)
+		return -EINVAL;
+	mhz = 500 + state * 50;
+	change.posdiv = mhz < 1000;
+	change.pcw = mhz / (change.posdiv ? 25 : 50);
+	if (airoha_cpu_pll_clk_get(priv) == mhz * 1000000UL)
+		return 0;
+	return stop_machine(airoha_cpu_pll_change_stopped, &change, NULL);
+}
+
+static int airoha_cpu_pmdomain_set_performance_state(
+		struct generic_pm_domain *domain, unsigned int state)
+{
+	struct airoha_cpu_pmdomain_priv *priv =
+		container_of(domain, struct airoha_cpu_pmdomain_priv, pd);
+
+	if (priv->use_smc)
+		return airoha_cpu_smc_set_freq(state);
+
+	return airoha_cpu_pll_set_freq(priv, state);
+}
+
 
 static int airoha_cpu_pmdomain_probe(struct platform_device *pdev)
 {
@@ -70,18 +261,48 @@
 	const struct clk_init_data init = {
 		.name = "cpu",
 		.ops = &airoha_cpu_pmdomain_clk_ops,
-		/* Clock with no set_rate, can't cache */
 		.flags = CLK_GET_RATE_NOCACHE,
 	};
 	struct generic_pm_domain *pd;
+	unsigned long freq_hz;
 	int ret;
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
 
-	/* Init and register a get-only clk for Cpufreq */
+	/* Try ATF SMC first */
+	if (airoha_cpu_smc_clk_get()) {
+		priv->use_smc = true;
+		dev_info(dev, "using ATF SMC for CPU frequency control\n");
+	} else {
+		priv->use_smc = false;
+
+		/* Opt in only for the AN7581 board whose firmware needs it. */
+		if (!of_device_is_compatible(dev->of_node, "airoha,en7581-cpufreq") ||
+		    !of_property_read_bool(dev->of_node, "airoha,allow-pll-fallback"))
+			return dev_err_probe(dev, -ENODEV, "firmware returned no CPU frequency\n");
+		priv->pll_map = syscon_regmap_lookup_by_phandle(dev->of_node, "airoha,chip-scu");
+		if (IS_ERR(priv->pll_map))
+			return dev_err_probe(dev, PTR_ERR(priv->pll_map), "missing chip-SCU syscon\n");
+		if (regmap_might_sleep(priv->pll_map))
+			return dev_err_probe(dev, -EINVAL, "CPU PLL needs non-sleeping MMIO\n");
+		priv->mcucfg = devm_platform_ioremap_resource_byname(pdev, "mcucfg");
+		if (IS_ERR(priv->mcucfg))
+			return dev_err_probe(dev, PTR_ERR(priv->mcucfg), "missing MCU clock registers\n");
+		raw_spin_lock_init(&priv->rate_lock);
+
+		dev_info(dev, "ATF SMC not available, using direct PLL programming\n");
+	}
+
+	/* Read and verify current frequency */
 	priv->hw.init = &init;
+	freq_hz = airoha_cpu_pmdomain_clk_get(&priv->hw, 0);
+	if (!freq_hz || freq_hz > 2000000000UL)
+		return dev_err_probe(dev, -ENODEV,
+				     "invalid CPU frequency: %lu Hz\n", freq_hz);
+
+	dev_info(dev, "CPU frequency: %lu MHz\n", freq_hz / 1000000);
 	ret = devm_clk_hw_register(dev, &priv->hw);
 	if (ret)
 		return ret;
@@ -106,12 +327,10 @@
 		goto err_add_provider;
 
 	platform_set_drvdata(pdev, priv);
-
 	return 0;
 
 err_add_provider:
 	pm_genpd_remove(pd);
-
 	return ret;
 }
 
