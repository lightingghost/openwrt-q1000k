Subject: [PATCH] net: airoha: preserve TTL and IPv6 source MAC for bridged IP

Implement the bridge flowtable TTL_KEEP action. Keep routed entries unchanged.
Use the same IPv6 source-MAC preservation selector as existing L2 subflows.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1099,6 +1099,7 @@
 	u8 dsfield = 0, l4proto = 0;
 	int err, i, offload_type;
 	u16 addr_type = 0;
+	bool keep_ttl = false;
 
 	if (rhashtable_lookup(&eth->flow_table, &f->cookie,
 			      airoha_flow_table_params))
@@ -1167,6 +1168,9 @@
 			if (act->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_ETH)
 				airoha_ppe_flow_mangle_eth(act, &data.eth);
 			break;
+		case FLOW_ACTION_TTL_KEEP:
+			keep_ttl = true;
+			break;
 		case FLOW_ACTION_REDIRECT:
 			odev = act->dev;
 			break;
@@ -1203,6 +1207,19 @@
 					   &data, l4proto, dsfield);
 	if (err)
 		return err;
+
+	if (keep_ttl) {
+		hwe.ib1 &= ~AIROHA_FOE_IB1_BIND_TTL;
+		/* IPv6 entries select a source-MAC register instead of storing
+		 * the full address. 0xf preserves the received source, as in
+		 * airoha_ppe_foe_commit_subflow_entry().
+		 */
+		if (offload_type == PPE_PKT_TYPE_IPV6_ROUTE_5T) {
+			hwe.ipv6.l2.src_mac_hi &= ~AIROHA_FOE_MAC_SMAC_ID;
+			hwe.ipv6.l2.src_mac_hi |=
+				FIELD_PREP(AIROHA_FOE_MAC_SMAC_ID, 0xf);
+		}
+	}
 
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
 		struct flow_match_ports ports;
