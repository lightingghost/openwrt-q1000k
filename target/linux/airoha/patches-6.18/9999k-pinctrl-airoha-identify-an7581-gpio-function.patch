Subject: [PATCH] pinctrl: airoha: identify the AN7581 GPIO mux function

The Q1000K controller first selects a GPIO mux state and then requests GPIO
descriptors. With strict pinmux ownership, the GPIO request was rejected
because the already selected "gpio" function was treated as a peripheral:

  pin gpio9 already requested by 0-0051; cannot claim for ...:521

Mark the AN7581 GPIO function and expose the generic function classifier.
Keep strict ownership for peripheral functions. This permits GPIO use of
pins explicitly muxed to GPIO without dropping the mux state or weakening
ownership checks for UART, PON, SPI and other peripheral functions.

--- a/drivers/pinctrl/airoha/pinctrl-airoha.c
+++ b/drivers/pinctrl/airoha/pinctrl-airoha.c
@@ -451,6 +451,7 @@ static const struct pinmux_ops airoha_pmxops = {
 	.get_functions_count = pinmux_generic_get_function_count,
 	.get_function_name = pinmux_generic_get_function_name,
 	.get_function_groups = pinmux_generic_get_function_groups,
+	.function_is_gpio = pinmux_generic_function_is_gpio,
 	.gpio_set_direction = airoha_pinmux_set_direction,
 	.set_mux = airoha_pinmux_set_mux,
 	.strict = true,
--- a/drivers/pinctrl/airoha/pinctrl-an7581.c
+++ b/drivers/pinctrl/airoha/pinctrl-an7581.c
@@ -1243,7 +1243,12 @@ static const struct airoha_pinctrl_func pinctrl_funcs[] = {
 	PINCTRL_FUNC_DESC("i2s", i2s),
 	PINCTRL_FUNC_DESC("emmc", emmc),
 	PINCTRL_FUNC_DESC("pnand", pnand),
-	PINCTRL_FUNC_DESC("gpio", gpio),
+	{
+		.desc = PINCTRL_GPIO_PINFUNCTION("gpio", gpio_groups,
+						ARRAY_SIZE(gpio_groups)),
+		.groups = gpio_func_group,
+		.group_size = ARRAY_SIZE(gpio_func_group),
+	},
 	PINCTRL_FUNC_DESC("pcie_reset", pcie_reset),
 	PINCTRL_FUNC_DESC("pwm", pwm),
 	PINCTRL_FUNC_DESC("phy1_led0", phy1_led0),
