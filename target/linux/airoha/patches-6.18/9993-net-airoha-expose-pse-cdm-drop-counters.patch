From: lightingghost <zhenp3ngzhou@gmail.com>
Subject: [PATCH] net: airoha: expose AN7581 PSE and CDM drop diagnostics

Extend the existing AN7581-only read-only snapshot with the ten PSE port
drop counters and CDM1/2 hardware-forwarding drop counters used by the
original community FlowSense card. Read CDM under the corresponding GDM
port's statistics lock when present. Do not clear counters or sample the
GDM counters managed by airoha_update_hw_stats(). Userspace handles first
samples and decreases (counter reset/wrap) explicitly.

Register offsets match the W1700K applications pack c180c48b4e and:
https://github.com/merbanan/air_tools/blob/main/fe_reg.sh

--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -181,12 +181,34 @@
 #define REG_PSE_SHARE_BUF_STA		(PSE_BASE + 0x04)
 #define PSE_SHARE_USED_MASK		GENMASK(31, 16)
 #define PSE_FREE_PAGES_MASK		GENMASK(14, 0)
+#define REG_PSE_PORT_DROP_CNT(n)		(PSE_BASE + 0x20 + (n) * 4)
+#define REG_CDM_RX_HWF_DROP_CNT(n)	(CDM_BASE(n) + 0x1a4)
+#define AN7581_PSE_MONITOR_PORTS		10
+
+/* The original AN7581 dashboard reads CDM1/2 RXHWF_DROP, not GDM RX_DROP.
+ * Serialize the read with the matching GDM MIB update where a port exists.
+ * Do not read, clear or substitute the driver's GDM packet counters.
+ */
+static u32 airoha_ppe_cdm_hwf_drop(struct airoha_eth *eth, unsigned int id)
+{
+	struct airoha_gdm_port *port = eth->ports[id - 1];
+	u32 value;
+
+	if (port)
+		spin_lock_bh(&port->lock);
+	value = airoha_fe_rr(eth, REG_CDM_RX_HWF_DROP_CNT(id));
+	if (port)
+		spin_unlock_bh(&port->lock);
+
+	return value;
+}
 
 static int airoha_ppe_debugfs_pse_show(struct seq_file *m, void *private)
 {
 	struct airoha_ppe *ppe = m->private;
 	struct airoha_eth *eth = ppe->eth;
 	u32 status, total, reserved, high;
+	unsigned int i;
 
 	status = airoha_fe_rr(eth, REG_PSE_SHARE_BUF_STA);
 	total = airoha_fe_get(eth, PSE_FQ_CFG, PSE_FQ_LIMIT_MASK);
@@ -194,9 +216,15 @@
 	high = airoha_fe_get(eth, REG_PSE_SHARE_USED_THD,
 			     PSE_SHARE_USED_HTHD_MASK);
 
-	seq_printf(m, "version 1\ntotal %u\nreserved %u\nused %u\nfree %u\nhigh %u\n",
+	seq_printf(m, "version 2\ntotal %u\nreserved %u\nused %u\nfree %u\nhigh %u\n",
 		   total, reserved, (u32)FIELD_GET(PSE_SHARE_USED_MASK, status),
 		   (u32)FIELD_GET(PSE_FREE_PAGES_MASK, status), high);
+	for (i = 0; i < AN7581_PSE_MONITOR_PORTS; i++)
+		seq_printf(m, "pse_drop%u %u\n", i,
+			   airoha_fe_rr(eth, REG_PSE_PORT_DROP_CNT(i)));
+	for (i = 1; i <= 2; i++)
+		seq_printf(m, "cdm%u_hwf_drop %u\n", i,
+			   airoha_ppe_cdm_hwf_drop(eth, i));
 	return 0;
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_pse);
