Subject: [PATCH] netfilter: fix standalone bridge flow ownership and forwarding

Keep bridge and routed path selection separate, walk both directions and
require registered ingress devices. Preserve TTL/hop limit and DSCP on the
software bridge fast path. Request TTL preservation explicitly in hardware
rules so drivers without support fall back to software. Fix the double free
on refragmentation failure and parse PPPoE headers at skb->data.

--- a/include/net/flow_offload.h
+++ b/include/net/flow_offload.h
@@ -184,6 +184,7 @@
 	FLOW_ACTION_VLAN_PUSH_ETH,
 	FLOW_ACTION_VLAN_POP_ETH,
 	FLOW_ACTION_CONTINUE,
+	FLOW_ACTION_TTL_KEEP,	/* Bridged IP: preserve TTL/hop limit. */
 	NUM_FLOW_ACTIONS,
 };
 
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -173,6 +173,7 @@
 	NF_FLOW_HW_PENDING,
 	NF_FLOW_HW_BIDIRECTIONAL,
 	NF_FLOW_HW_ESTABLISHED,
+	NF_FLOW_BRIDGE,
 };
 
 enum flow_offload_type {
--- a/net/bridge/netfilter/nf_conntrack_bridge.c
+++ b/net/bridge/netfilter/nf_conntrack_bridge.c
@@ -264,13 +264,26 @@
 	} else if (*proto == htons(ETH_P_PPP_SES)) {
 		struct pppoe_hdr *phdr;
 
-		if (!pskb_may_pull(skb, skb_mac_offset(skb) + ETH_HLEN + PPPOE_SES_HLEN))
+		if (!pskb_may_pull(skb, PPPOE_SES_HLEN))
 			return -1;
 
-		phdr = (struct pppoe_hdr *)(skb_mac_header(skb) + ETH_HLEN);
+		phdr = (struct pppoe_hdr *)skb->data;
+		if (phdr->ver != 1 || phdr->type != 1 || phdr->code ||
+		    ntohs(phdr->length) < 2 ||
+		    ntohs(phdr->length) > skb->len - sizeof(*phdr))
+			return -1;
 		data->pppoe_proto = *(__be16 *)(phdr + 1);
 		data->pppoe_sid = phdr->sid;
-		*proto = data->pppoe_proto == htons(PPP_IP) ? htons(ETH_P_IP) : data->pppoe_proto == htons(PPP_IPV6) ? htons(ETH_P_IPV6) : *proto;
+		switch (data->pppoe_proto) {
+		case htons(PPP_IP):
+			*proto = htons(ETH_P_IP);
+			break;
+		case htons(PPP_IPV6):
+			*proto = htons(ETH_P_IPV6);
+			break;
+		default:
+			return -1;
+		}
 		data->pppoe_present = true;
 		return PPPOE_SES_HLEN;
 	}
@@ -345,11 +358,16 @@
 	if (ret != NF_ACCEPT)
 		return ret;
 
-	__skb_push(skb, offset);
-	return nf_conntrack_in(skb, &bridge_state);
+	ret = nf_conntrack_in(skb, &bridge_state);
+	if (ret == NF_ACCEPT) {
+		__skb_push(skb, offset);
+		skb_reset_network_header(skb);
+	}
+	return ret;
 
 notrack:
 	__skb_push(skb, offset);
+	skb_reset_network_header(skb);
 	nf_ct_set(skb, NULL, IP_CT_UNTRACKED);
 	return NF_ACCEPT;
 }
@@ -428,7 +446,7 @@
 
 	WARN_ON_ONCE(1);
 drop:
-	kfree_skb(skb);
+	/* NF_DROP transfers freeing to nf_hook_slow(). */
 	return NF_DROP;
 }
 
