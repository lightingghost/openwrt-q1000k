+/* Process context, MAC ingress/egress still held stopped. After full RX drain
+ * and old service-table removal, invalidate all TX epochs and RX generations
+ * before allowing retired channels to be programmed again. Leaves RX DMA,
+ * RX callbacks and CPU queues closed. Never clears a hardware fault.
+ */
+int airoha_pon_reset_epoch(struct airoha_pon *pon);
+/* After replacement service tables and TX-channel configuration are verified,
