+/* Only an owner that completed full FE/MAC/RX retirement may replace the
+ * namespace. Queue epochs and RX generation change before reuse is allowed.
+ */
+int airoha_pon_reset_epoch(struct airoha_pon *pon)
+{
+	struct airoha_gdm_dev *dev;
+	struct airoha_eth *eth;
+	unsigned long flags;
+	u32 dma;
+	int i, ret = 0;
+
+	if (!pon)
+		return -EINVAL;
+	if (in_interrupt() || irqs_disabled())
+		return -EWOULDBLOCK;
+	rtnl_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	if (!rcu_access_pointer(pon->netdev))
+		ret = -ENODEV;
+	else if (pon->control_fault)
+		ret = -EIO;
+	else if (pon->configuring || !pon->paused || !pon->pause_ready ||
+		 !pon->rx_closed || !pon->rx_drained ||
+		 pon->fe_retired != U32_MAX || pon->epoch_ready ||
+		 atomic_read_acquire(&pon->pending))
+		ret = -EBUSY;
+	if (ret)
+		goto out;
+	dev = pon->dma_dev;
+	eth = dev->eth;
+	for (i = 0; i < 32; i++)
+		if (pon->epoch[i] == U64_MAX || dev->pon_generation == U64_MAX) {
+			ret = -EOVERFLOW;
+			goto fault;
+		}
+	dma = airoha_qdma_rr(&eth->qdma[1], REG_QDMA_GLOBAL_CFG);
+	if (dma == U32_MAX ||
+	    (dma & (GLOBAL_CFG_RX_DMA_EN_MASK | GLOBAL_CFG_RX_DMA_BUSY_MASK)) ||
+	    airoha_fe_rr(eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX)) ||
+	    airoha_fe_rr(eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX)) ||
+	    airoha_fe_rr(eth, REG_CDM_HWFWD_CHN(AIROHA_GDM2_IDX))) {
+		ret = -EIO;
+		goto fault;
+	}
+	for (i = 0; i < 32; i += 4)
+		if (airoha_qdma_rr(&eth->qdma[1], REG_QUEUE_CLOSE_CFG(i)) != U32_MAX) {
+			ret = -EIO;
+			goto fault;
+		}
+	for (i = 0; i < 32; i++)
+		pon->epoch[i]++;
+	WRITE_ONCE(pon->generation, ++dev->pon_generation);
+	memset(pon->closed, 0xff, sizeof(pon->closed));
+	memset(pon->paused_closed, 0xff, sizeof(pon->paused_closed));
+	pon->retiring = 0;
+	pon->fe_retired = 0;
+	pon->tx_enabled = 0;
+	pon->epoch_ready = true;
+	goto out;
+fault:
+	pon->control_fault = true;
+out:
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	rtnl_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_reset_epoch);
+
+int airoha_pon_activate_rx(struct airoha_pon *pon, u32 channels)
+{
+	struct airoha_eth *eth;
+	struct airoha_qdma *qdma;
+	unsigned long flags;
+	u32 before, after;
+	int ret = 0;
+
+	if (!pon || !channels)
+		return -EINVAL;
+	if (in_interrupt() || irqs_disabled())
+		return -EWOULDBLOCK;
+	rtnl_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	if (!rcu_access_pointer(pon->netdev))
+		ret = -ENODEV;
+	else if (pon->control_fault)
+		ret = -EIO;
+	else if (pon->configuring || !pon->paused || !pon->pause_ready ||
+		 !pon->rx_closed || !pon->rx_drained || !pon->epoch_ready)
+		ret = -EBUSY;
+	else if ((channels & ~pon->tx_enabled) || (channels & pon->retiring))
+		ret = -EINVAL;
+	if (ret)
+		goto out;
+	eth = pon->dma_dev->eth;
+	qdma = &eth->qdma[1];
+	before = airoha_qdma_rr(qdma, REG_QDMA_GLOBAL_CFG);
+	if (before == U32_MAX ||
+	    (before & (GLOBAL_CFG_RX_DMA_EN_MASK | GLOBAL_CFG_RX_DMA_BUSY_MASK)) ||
+	    airoha_fe_rr(eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX))) {
+		ret = -EIO;
+		goto fault;
+	}
+	/* Receive DMA is ready before FE can admit packets for the new tables. */
+	airoha_qdma_set(qdma, REG_QDMA_GLOBAL_CFG, GLOBAL_CFG_RX_DMA_EN_MASK);
+	after = airoha_qdma_rr(qdma, REG_QDMA_GLOBAL_CFG);
+	if (after == U32_MAX || !(after & GLOBAL_CFG_RX_DMA_EN_MASK) ||
+	    ((after ^ before) & ~(GLOBAL_CFG_RX_DMA_EN_MASK |
+				GLOBAL_CFG_RX_DMA_BUSY_MASK |
+				GLOBAL_CFG_TX_DMA_BUSY_MASK))) {
+		ret = -EIO;
+		goto fault;
+	}
+	ret = airoha_pon_fe_write_checked(eth,
+					REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX), channels);
+	if (ret)
+		goto fault;
+	pon->rx_drained = false;
+	pon->epoch_ready = false;
+	smp_store_release(&pon->rx_closed, false);
+	goto out;
+fault:
+	/* Keep admission closed even if physical containment fails. No page is
+	 * freed here; DMA ownership is retained for the next lower teardown.
+	 */
+	airoha_pon_fe_write_checked(eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX), 0);
+	airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG, GLOBAL_CFG_RX_DMA_EN_MASK);
+	pon->control_fault = true;
+out:
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	rtnl_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_activate_rx);
+
 int airoha_pon_set_queue_close(struct airoha_pon *pon, u8 channel, u8 closed)
 {
 	unsigned long flags;
