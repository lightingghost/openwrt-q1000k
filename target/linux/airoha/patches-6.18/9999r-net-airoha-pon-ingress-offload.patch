+int airoha_pon_resolve_ingress(struct airoha_eth *eth, struct net_device *upper,
+			     u16 ethertype, struct airoha_pon_flow *flow,
+			     struct airoha_gdm_dev **owner)
+{
+	struct airoha_gdm_port *port = eth->ports[AIROHA_GDM2_IDX - 1];
+	unsigned long flags;
+	int i, ret = -ENOENT;
+
+	if (!upper || !port)
+		return ret;
+	rcu_read_lock();
+	for (i = 0; i < ARRAY_SIZE(port->devs); i++) {
+		struct airoha_gdm_dev *dev = port->devs[i];
+		struct airoha_pon *pon;
+
+		if (!dev || !dev->pon_port)
+			continue;
+		pon = rcu_dereference(dev->pon);
+		if (!pon || !pon->ops->rx_flow)
+			continue;
+		spin_lock_irqsave(&pon->admission_lock, flags);
+		ret = rcu_access_pointer(pon->netdev) == netdev_from_priv(dev) ?
+			pon->ops->rx_flow(pon->priv, upper, ethertype, flow) : -ENODEV;
+		if (!ret && (pon->paused || pon->control_fault || dev->pon_flow_fault ||
+		    pon->rx_closed || !netif_running(upper) ||
+		    !is_valid_ether_addr(upper->dev_addr)))
+			ret = -ESHUTDOWN;
+		if (!ret && !ether_addr_equal(dev->pon_smac, upper->dev_addr)) {
+			airoha_pon_invalidate_flows_locked(pon);
+			if (pon->control_fault || dev->pon_flow_fault)
+				ret = -EIO;
+			else {
+				airoha_ppe_init_upd_mem(dev, upper->dev_addr);
+				ether_addr_copy(dev->pon_smac, upper->dev_addr);
+			}
+		}
+		if (!ret) {
+			flow->epoch = dev->pon_flow_epoch;
+			ret = airoha_ppe_pon_ingress(dev, flow, ethertype, upper->dev_addr);
+			if (!ret)
+				*owner = dev;
+		}
+		spin_unlock_irqrestore(&pon->admission_lock, flags);
+		if (ret != -ENOENT)
+			break;
+	}
+	rcu_read_unlock();
+	return ret;
+}
