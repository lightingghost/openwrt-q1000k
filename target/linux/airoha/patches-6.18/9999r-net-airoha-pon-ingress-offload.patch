+++ b/drivers/net/ethernet/airoha/airoha_pon_ifc.h
@@ -0,0 +1,354 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Q1000K AN7581 ingress admission. Included by the native PPE owner only.
+ * Register layout checked against the factory AN7581 IFC encoder. The
+ * classifier checks each frame BEFORE PPE lookup; an IP tuple alone cannot
+ * represent the OMCI GEM/VLAN authorization boundary.
+ */
+#define PON_IFC_CMD		0x0204
+#define PON_IFC_DATA(n)		(0x0210 + 4 * (n))
+#define PON_IFC_ACK		BIT(31)
+#define PON_IFC_REQUEST		BIT(0)
+#define PON_IFC_WRITE		BIT(1)
+#define PON_IFC_ACTION		(2 << 4)
+#define PON_IFC_RULE_ENABLE	BIT(31)
+#define PON_IFC_RULE_END		BIT(30)
+#define PON_IFC_FORCE_PORT	BIT(28)
+#define PON_IFC_ROWS		64
+
+/* Type zero: Ethernet/GEM key, nine words in reverse hardware word order.
+ * VPM=1 denotes 802.1Q; VLAN0/1 validity distinguishes an untagged frame
+ * from VID zero and rejects stacked tags. PCP/DEI are intentionally wildcard
+ * only after the consumer proves all sixteen variants reach the same UNI.
+ */
+static void airoha_pon_ifc_encode(const struct airoha_pon_flow *flow,
+				u16 ethertype, const u8 *dmac,
+				u32 key[9], u32 mask[9], u32 action[6])
+{
+	memset(key, 0, 9 * sizeof(*key));
+	memset(mask, 0, 9 * sizeof(*mask));
+	memset(action, 0, 6 * sizeof(*action));
+	mask[0] = GENMASK(7, 6);
+	key[1] = (u32)flow->gem << 16;
+	mask[1] = GENMASK(31, 16) | BIT(11) | BIT(10) | BIT(5) | BIT(4);
+	/* LLC and PPPoE must both be absent. */
+	if (flow->num_vlans) {
+		key[1] |= BIT(5) | BIT(2);
+		mask[1] |= GENMASK(3, 2);
+		key[2] = ((u32)flow->vlan[0] & VLAN_VID_MASK) << 20 |
+			 (u32)(flow->vlan[0] >> 12) << 16;
+		mask[2] = GENMASK(31, 20) | (u32)(flow->rx_tci_mask >> 12) << 16;
+	}
+	key[3] = ethertype;
+	mask[3] = 0xffff;
+	key[5] = (u32)dmac[2] << 24 | (u32)dmac[3] << 16 |
+		 (u32)dmac[4] << 8 | dmac[5];
+	mask[5] = U32_MAX;
+	key[6] = (u32)dmac[0] << 24 | (u32)dmac[1] << 16;
+	mask[6] = GENMASK(31, 16);
+	key[8] = BIT(AIROHA_GDM2_IDX);
+	mask[8] = U32_MAX;
+	action[0] = PON_IFC_RULE_ENABLE | PON_IFC_RULE_END;
+	action[2] = PON_IFC_FORCE_PORT;
+	action[5] = FE_PSE_PORT_PPE1 << 8;
+}
+
+static int airoha_pon_ifc_command(struct airoha_eth *eth, u32 command)
+{
+	u32 value;
+	int err;
+
+	airoha_fe_wr(eth, PON_IFC_CMD, command | PON_IFC_REQUEST);
+	err = read_poll_timeout_atomic(airoha_fe_rr, value, value & PON_IFC_ACK,
+					1, 100, false, eth, PON_IFC_CMD);
+	if (err)
+		dev_err(eth->dev, "PON IFC command timeout: cmd=%#010x read=%#010x\n",
+			(u32)(command | PON_IFC_REQUEST), value);
+	return err;
+}
+
+/* Every indirect word is read back. A timeout or mismatch leaves the port
+ * closed and is treated as an uncertain hardware transaction.
+ */
+static int airoha_pon_ifc_word(struct airoha_eth *eth, unsigned int row,
+			     unsigned int word, bool action,
+			     const u32 *data, unsigned int count)
+{
+	u32 cmd = row << 16 | word << 8 | (action ? PON_IFC_ACTION : 0);
+	unsigned int i;
+	int err;
+
+	for (i = 0; i < count; i++)
+		airoha_fe_wr(eth, PON_IFC_DATA(i), data[i]);
+	err = airoha_pon_ifc_command(eth, cmd | PON_IFC_WRITE);
+	if (err)
+		return err;
+	err = airoha_pon_ifc_command(eth, cmd);
+	if (err)
+		return err;
+	for (i = 0; i < count; i++) {
+		u32 value = airoha_fe_rr(eth, PON_IFC_DATA(i));
+		/* TCAM key bits outside the match mask are don't-care. AN7581
+		 * reads 0x3f for a type-zero key of 0 with mask 0xc0. Check
+		 * significant key bits, but every mask/action bit verbatim.
+		 */
+		u32 verify_mask = !action && !i ? data[1] : U32_MAX;
+
+		if ((value ^ data[i]) & verify_mask) {
+			dev_err(eth->dev,
+				"PON IFC readback: %s row=%u word=%u reg=%#06x expected=%#010x read=%#010x verify=%#010x cmd=%#010x\n",
+				action ? "action" : "rule", row, word,
+				PON_IFC_DATA(i), data[i], value, verify_mask,
+				airoha_fe_rr(eth, PON_IFC_CMD));
+			return -EIO;
+		}
+	}
+	return 0;
+}
+
+static int airoha_pon_ifc_action(struct airoha_eth *eth, unsigned int row,
+			       const u32 action[6])
+{
+	u32 data[3];
+	int err;
+
+	data[0] = action[5]; data[1] = action[4];
+	err = airoha_pon_ifc_word(eth, row, 0, true, data, 2);
+	if (err)
+		return err;
+	data[0] = action[3]; data[1] = action[2]; data[2] = action[1];
+	err = airoha_pon_ifc_word(eth, row, 1, true, data, 3);
+	if (err)
+		return err;
+	/* The rule enable/end word is published last. */
+	return airoha_pon_ifc_word(eth, row, 2, true, action, 1);
+}
+
+static int airoha_pon_ifc_register(struct airoha_eth *eth, u32 reg,
+				 u32 mask, u32 expected)
+{
+	u32 value;
+
+	airoha_fe_rmw(eth, reg, mask, expected);
+	value = airoha_fe_rr(eth, reg);
+	if ((value & mask) == expected)
+		return 0;
+	dev_err(eth->dev,
+		"PON IFC register: reg=%#06x mask=%#010x expected=%#010x read=%#010x\n",
+		reg, mask, expected, value);
+	return -EIO;
+}
+
+static int airoha_pon_ifc_port(struct airoha_eth *eth, bool enable)
+{
+	u32 bit = BIT(AIROHA_GDM2_IDX);
+
+	return airoha_pon_ifc_register(eth, REG_FE_IFC_PORT_EN, bit,
+				     enable ? bit : 0);
+}
+
+static int airoha_ppe_pon_ifc_close(struct airoha_gdm_dev *dev)
+{
+	int ret;
+
+	lockdep_assert_held(&ppe_lock);
+	ret = airoha_pon_ifc_port(dev->eth, false);
+	dev->pon_ingress[0].valid = false;
+	dev->pon_ingress[1].valid = false;
+	return ret;
+}
+
+int airoha_ppe_pon_ingress(struct airoha_gdm_dev *dev,
+			 const struct airoha_pon_flow *flow, u16 ethertype,
+			 const u8 *dmac)
+{
+	struct airoha_eth *eth = dev->eth;
+	struct airoha_pon_ingress *profile;
+	u32 key[9], mask[9], action[6], empty[6] = {};
+	unsigned int row = ethertype == ETH_P_IPV6, i;
+	unsigned long flags;
+	const char *stage = "close-port";
+	u32 saved_ports = 0;
+	bool initializing = false;
+	int err;
+
+	if (!airoha_is_7581(eth) || !airoha_ppe_is_enabled(eth, 0) ||
+	    (ethertype != ETH_P_IP && ethertype != ETH_P_IPV6) ||
+	    !flow->gem || flow->gem >= 0x4000 || flow->num_vlans > 1 ||
+	    (flow->num_vlans && flow->rx_tci_mask != VLAN_VID_MASK &&
+	     flow->rx_tci_mask != 0xffff) || !is_valid_ether_addr(dmac))
+		return -EOPNOTSUPP;
+	spin_lock_irqsave(&ppe_lock, flags);
+	if (dev->pon_flow_fault || flow->epoch != dev->pon_flow_epoch) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	if (dev->pon_ifc_failed) {
+		err = -EOPNOTSUPP;
+		goto unlock;
+	}
+	profile = &dev->pon_ingress[row];
+	if (profile->valid) {
+		/* Never replace an admitted namespace while its flows exist. */
+		err = profile->flow.gem == flow->gem &&
+			profile->flow.num_vlans == flow->num_vlans &&
+			profile->flow.vlan[0] == flow->vlan[0] &&
+			profile->flow.rx_tci_mask == flow->rx_tci_mask &&
+			ether_addr_equal(profile->dmac, dmac) ? 0 : -EBUSY;
+		goto unlock;
+	}
+	err = airoha_pon_ifc_port(eth, false);
+	if (err)
+		goto fault;
+	if (!dev->pon_ifc_initialized) {
+		/* Native FE starts IFC disabled. Refuse ownership if another
+		 * consumer has enabled it; do not clear someone else's rules.
+		 */
+		if (airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) {
+			err = -EBUSY;
+			goto unlock;
+		}
+		/* Factory init_module enables IFC before touching its tables.
+		 * Isolate ALL inputs while the table contents are untrusted;
+		 * native LAN ports may already have their per-port bit set.
+		 */
+		saved_ports = airoha_fe_rr(eth, REG_FE_IFC_PORT_EN);
+		initializing = true;
+		stage = "isolate-inputs";
+		err = airoha_pon_ifc_register(eth, REG_FE_IFC_PORT_EN, U32_MAX, 0);
+		if (err)
+			goto fault;
+		stage = "enable-table-access";
+		err = airoha_pon_ifc_register(eth, REG_FE_CSR_IFC_CFG,
+					    FE_IFC_EN_MASK, FE_IFC_EN_MASK);
+		if (err)
+			goto fault;
+		stage = "clear-actions";
+		for (i = 0; i < PON_IFC_ROWS; i++) {
+			err = airoha_pon_ifc_action(eth, i, empty);
+			if (err)
+				goto fault;
+		}
+		stage = "restore-inputs";
+		err = airoha_pon_ifc_register(eth, REG_FE_IFC_PORT_EN, U32_MAX,
+					    saved_ports & ~BIT(AIROHA_GDM2_IDX));
+		if (err)
+			goto fault;
+		initializing = false;
+		dev->pon_ifc_initialized = true;
+	}
+	/* A closed epoch may still have enabled action words in RAM. Clear
+	 * every stale family before reopening the shared ingress port.
+	 */
+	stage = "clear-stale-profiles";
+	for (i = 0; i < 2; i++) {
+		if (dev->pon_ingress[i].valid)
+			continue;
+		err = airoha_pon_ifc_action(eth, i, empty);
+		if (err)
+			goto fault;
+	}
+	airoha_pon_ifc_encode(flow, ethertype, dmac, key, mask, action);
+	stage = "clear-profile";
+	err = airoha_pon_ifc_action(eth, row, empty);
+	if (err)
+		goto fault;
+	stage = "write-rule";
+	for (i = 0; i < 9; i++) {
+		u32 data[2] = { key[i], mask[i] };
+
+		err = airoha_pon_ifc_word(eth, row, 8 - i, false, data, 2);
+		if (err)
+			goto fault;
+	}
+	stage = "write-action";
+	err = airoha_pon_ifc_action(eth, row, action);
+	if (err)
+		goto fault;
+	/* A PPE miss must return to the exclusive PON QDMA1 owner. */
+	stage = "cpu-port";
+	airoha_ppe_set_cpu_port(dev, 0, AIROHA_GDM2_IDX);
+	if (FIELD_GET(DFT_CPORT_MASK(AIROHA_GDM2_IDX),
+		      airoha_fe_rr(eth, REG_PPE_DFT_CPORT(0, AIROHA_GDM2_IDX))) !=
+	    FE_PSE_PORT_CDM2) {
+		dev_err(eth->dev,
+			"PON IFC CPU port: reg=%#06x expected=%u read=%#010x\n",
+			REG_PPE_DFT_CPORT(0, AIROHA_GDM2_IDX), FE_PSE_PORT_CDM2,
+			airoha_fe_rr(eth, REG_PPE_DFT_CPORT(0, AIROHA_GDM2_IDX)));
+		err = -EIO;
+		goto fault;
+	}
+	stage = "enable-classifier";
+	err = airoha_pon_ifc_register(eth, REG_FE_CSR_IFC_CFG,
+				    FE_IFC_EN_MASK, FE_IFC_EN_MASK);
+	if (err)
+		goto fault;
+	*profile = (struct airoha_pon_ingress) { .flow = *flow, .valid = true };
+	ether_addr_copy(profile->dmac, dmac);
+	stage = "open-port";
+	err = airoha_pon_ifc_port(eth, true);
+	if (!err) {
+		netdev_info(netdev_from_priv(dev),
+			    "PON IFC IPv%u enabled: GEM %u tags %u TCI %#06x/%#06x epoch %llu\n",
+			    row ? 6 : 4, flow->gem, flow->num_vlans,
+			    flow->vlan[0], flow->rx_tci_mask, flow->epoch);
+		goto unlock;
+	}
+ fault:
+	netdev_err(netdev_from_priv(dev),
+		   "PON IFC transaction failed: stage=%s IPv%u error=%d\n",
+		   stage, row ? 6 : 4, err);
+	/* Never retry or reopen IFC in this FE lifetime after a failed
+	 * transaction. With GDM2 disconnected, even a late table write or
+	 * an existing downstream PPE entry cannot admit another PON frame.
+	 * Upstream PPE and the existing CPU receive path remain usable.
+	 */
+	dev->pon_ifc_failed = true;
+	if (initializing &&
+	    !airoha_pon_ifc_register(eth, REG_FE_CSR_IFC_CFG, FE_IFC_EN_MASK, 0))
+		airoha_pon_ifc_register(eth, REG_FE_IFC_PORT_EN, U32_MAX,
+					saved_ports & ~BIT(AIROHA_GDM2_IDX));
+	if (airoha_ppe_pon_ifc_close(dev)) {
+		netdev_err(netdev_from_priv(dev),
+			   "PON IFC isolation failed; stopping PON traffic\n");
+		airoha_ppe_pon_fault(dev);
+	} else {
+		netdev_warn(netdev_from_priv(dev),
+			    "PON IFC disabled until reboot; downstream remains in software\n");
+	}
+ unlock:
+	spin_unlock_irqrestore(&ppe_lock, flags);
+	return err;
+}
+
+/* Recheck the raw software frame when training, including metadata rejected
+ * by the PON boundary before this call. No skb mutation or service accounting
+ * occurs here. An IFC miss or an old hash must never train a generic LAN flow.
+ */
+static bool airoha_ppe_pon_ifc_frame(struct airoha_gdm_dev *dev,
+				   struct sk_buff *skb,
+				   const struct airoha_pon_rx_meta *meta)
+{
+	struct airoha_pon_ingress *profile;
+	u8 header[ETH_HLEN + VLAN_HLEN];
+	u16 ethertype, vid = 0;
+	bool tagged;
+
+	lockdep_assert_held(&ppe_lock);
+	if (dev->pon_flow_fault || meta->omci || skb_vlan_tag_present(skb) ||
+	    skb_copy_bits(skb, 0, header, sizeof(header)))
+		return false;
+	ethertype = get_unaligned_be16(header + 12);
+	tagged = ethertype == ETH_P_8021Q;
+	if (tagged) {
+		vid = get_unaligned_be16(header + 14);
+		ethertype = get_unaligned_be16(header + 16);
+	}
+	if (ethertype != ETH_P_IP && ethertype != ETH_P_IPV6)
+		return false;
+	profile = &dev->pon_ingress[ethertype == ETH_P_IPV6];
+	return profile->valid && profile->flow.epoch == dev->pon_flow_epoch &&
+		profile->flow.gem == meta->gem &&
+		profile->flow.num_vlans == tagged &&
+		profile->flow.vlan[0] == (vid & profile->flow.rx_tci_mask) &&
+		ether_addr_equal(profile->dmac, header);
+}
