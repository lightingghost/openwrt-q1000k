+/* The handle is caller-owned; RCU also pins the native netdev/MMIO owner
+ * until detach clears netdev and waits for current control/TX calls.
+ */
+int airoha_pon_set_queue_close(struct airoha_pon *pon, u8 channel, u8 closed)
+{
+	struct net_device *netdev;
+	struct airoha_qdma *qdma;
+	unsigned long flags;
+	u32 mask, value;
+	int ret = 0;
+
+	if (!pon || channel >= ARRAY_SIZE(pon->closed))
+		return -EINVAL;
+	rcu_read_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	netdev = rcu_dereference(pon->netdev);
+	if (!netdev) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (pon->queue_fault) {
+		ret = -EIO;
+		goto out;
+	}
+	qdma = &pon->dma_dev->eth->qdma[1];
+	mask = 0xffU << ((channel & 3) * 8);
+	value = (u32)closed << ((channel & 3) * 8);
+	airoha_qdma_rmw(qdma, REG_QUEUE_CLOSE_CFG(channel), mask, value);
+	/* Flush the posted write and fail closed on a register mismatch. */
+	if ((airoha_qdma_rr(qdma, REG_QUEUE_CLOSE_CFG(channel)) & mask) != value) {
+		pon->queue_fault = true;
+		ret = -EIO;
+		goto out;
+	}
+	/* A new closure invalidates ALL software packets for this channel.
+	 * Reopening never grants old packets a new lease. Already submitted
+	 * descriptors and FE/optical FIFOs require a separate retirement step.
+	 */
+	if (closed & ~pon->closed[channel]) {
+		if (++pon->epoch[channel] == 0) {
+			pon->queue_fault = true;
+			ret = -EOVERFLOW;
+		}
+	}
+	pon->closed[channel] = closed;
+out:
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_set_queue_close);
+
+int airoha_pon_get_queue_close(struct airoha_pon *pon, u8 channel, u8 *closed)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!pon || !closed || channel >= ARRAY_SIZE(pon->closed))
+		return -EINVAL;
+	rcu_read_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	if (!rcu_dereference(pon->netdev))
+		ret = -ENODEV;
+	else if (pon->queue_fault)
+		ret = -EIO;
+	else
+		*closed = pon->closed[channel];
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_get_queue_close);
+
+int airoha_pon_prepare_tx(struct airoha_pon *pon, struct airoha_pon_tx_meta *meta)
+{
+	unsigned long flags;
+	u32 msg;
+	int ret;
+
+	if (!pon)
+		return -EINVAL;
+	ret = airoha_pon_tx_msg(meta, &msg);
+	if (ret)
+		return ret;
+	rcu_read_lock();
+	spin_lock_irqsave(&pon->admission_lock, flags);
+	if (!rcu_dereference(pon->netdev))
+		ret = -ENODEV;
+	else if (pon->queue_fault)
+		ret = -EIO;
+	else if (pon->closed[meta->channel] & BIT(meta->queue))
+		ret = -ESHUTDOWN;
+	else
+		meta->epoch = pon->epoch[meta->channel];
+	spin_unlock_irqrestore(&pon->admission_lock, flags);
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_prepare_tx);
