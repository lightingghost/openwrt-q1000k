+/* Queue configuration requires exclusive QDMA1 ownership: attach rejects
+ * every other assigned netdev (even down) and QoS allocation, then closes all
+ * 32 x 8 TX queues. set/get/prepare are IRQ-safe and serialized against TX.
+ * Callers must retain the handle and MUST NOT hold a consumer callback lock.
+ * closed has one bit per queue; get returns the last verified configuration,
+ * not hardware FIFO occupancy. Errors leave output arguments unchanged.
+ * An MMIO readback failure disables all software admission until reattach.
+ * Detach makes control calls return -ENODEV without touching registers.
+ * Closure is NOT retirement: previously submitted descriptors/FIFOs may still
+ * contain frames. Coordinate physical draining before reallocating T-CONTs.
+ */
+int airoha_pon_set_queue_close(struct airoha_pon *pon, u8 channel, u8 closed);
+int airoha_pon_get_queue_close(struct airoha_pon *pon, u8 channel, u8 *closed);
+
+/* Capture admission for a fully prepared frame BEFORE enqueueing it. Returns
+ * -ESHUTDOWN for a closed queue. xmit drops stale epochs even after reopen;
+ * never call prepare_tx again for a frame returned as NETDEV_TX_BUSY. A new
+ * closure invalidates all software packets on that channel conservatively.
+ */
+int airoha_pon_prepare_tx(struct airoha_pon *pon, struct airoha_pon_tx_meta *meta);
+
 /* NETDEV_TX_OK consumes skb, including on errors; NETDEV_TX_BUSY leaves it
  * unchanged and owned by the caller. Only complete, non-GSO frames with
  * software-computed checksums are supported. MIC generation/verification,
