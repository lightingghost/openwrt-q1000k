# Normal Q1000K image pair on q1000k-xgspon. Copy to .config, then make defconfig.
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_quantum_q1000k-ubi=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
CONFIG_PACKAGE_luci-ssl=y
# CONFIG_SIGN_EACH_PACKAGE is not set
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-airoha-flowsense=y
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y

# Both images share the normal UBI board and the PON runtime.
CONFIG_PACKAGE_q1000k-xgspon-wan=y
CONFIG_PACKAGE_luci-app-econet-xpon=y

CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.0.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.0.255"
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
