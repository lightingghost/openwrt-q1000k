# Add to an existing quantum_q1000k-ubi configuration on q1000k-xgspon.
# Development diagnostics only; this does not enable optical service.
CONFIG_PACKAGE_q1000k-xgspon=y
CONFIG_PACKAGE_luci-app-econet-xpon=y
CONFIG_PACKAGE_kmod-q1000k-pon-control=y
# CONFIG_PACKAGE_kmod-airoha-xpon-en757x is not set
